    "NSNetworkVolumesUsageDescription" : {
      "comment" : "Permission prompt: network drives",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ PureClean الملفات الموجودة على أقراص الشبكة فقط عندما تفحصها، مثلًا ليعرض المجلدات التي تملأ قرصًا مشتركًا. لا يُنقل أي شيء إلى سلة المهملات حتى تراجعه وتؤكده."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean læser kun filer på netværksdrev, når du scanner dem, for eksempel for at vise, hvilke mapper der fylder et delt drev. Intet flyttes til papirkurven, før du har gennemgået og bekræftet det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean liest Dateien auf Netzlaufwerken nur, wenn du sie scannst, zum Beispiel um zu zeigen, welche Ordner ein freigegebenes Laufwerk füllen. Nichts kommt in den Papierkorb, bevor du es geprüft und bestätigt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean reads files on network drives only when you scan them, for example to show which folders fill a shared drive. Nothing is moved to the Trash until you review and confirm it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean solo lee archivos de unidades de red cuando las analizas, por ejemplo, para mostrar qué carpetas llenan una unidad compartida. Nada se mueve a la Papelera hasta que lo revises y confirmes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean lukee verkkolevyjen tiedostoja vain, kun skannaat ne, esimerkiksi näyttääkseen, mitkä kansiot täyttävät jaetun levyn. Mitään ei siirretä roskakoriin ennen kuin olet tarkistanut ja vahvistanut sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ne lit les fichiers des disques réseau que lorsque vous les analysez, par exemple pour montrer quels dossiers remplissent un disque partagé. Rien n’est placé dans la Corbeille avant que vous l’ayez vérifié et confirmé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean नेटवर्क ड्राइव की फ़ाइलें तभी पढ़ता है जब आप उन्हें स्कैन करते हैं, जैसे यह दिखाने के लिए कि शेयर की गई ड्राइव किन फ़ोल्डरों से भरी है। जब तक आप समीक्षा करके पुष्टि नहीं करते, कुछ भी ट्रैश में नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean hanya membaca file di drive jaringan saat Anda memindainya, misalnya untuk menunjukkan folder mana yang memenuhi drive bersama. Tidak ada yang dipindahkan ke Sampah sebelum Anda meninjau dan mengonfirmasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean legge i file dei dischi di rete solo quando li analizzi, per esempio per mostrare quali cartelle riempiono un disco condiviso. Nulla viene spostato nel Cestino finché non lo hai controllato e confermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean は、ネットワークドライブのファイルをスキャンしたときにだけ読み取ります（共有ドライブをどのフォルダが占めているかを表示するためなど）。確認して承認するまで、何もゴミ箱に移動されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean은 네트워크 드라이브를 스캔할 때만 해당 파일을 읽습니다(예: 어떤 폴더가 공유 드라이브를 채우고 있는지 보여 주기 위해). 검토하고 확인하기 전에는 아무것도 휴지통으로 이동하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean leser bare filer på nettverksdisker når du skanner dem, for eksempel for å vise hvilke mapper som fyller en delt disk. Ingenting flyttes til papirkurven før du har gått gjennom og bekreftet det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean leest bestanden op netwerkschijven alleen als je ze scant, bijvoorbeeld om te laten zien welke mappen een gedeelde schijf vullen. Niets gaat naar de prullenmand voordat je het hebt bekeken en bevestigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean odczytuje pliki na dyskach sieciowych tylko wtedy, gdy je skanujesz, na przykład aby pokazać, które foldery zapełniają dysk udostępniony. Nic nie trafia do kosza, dopóki tego nie przejrzysz i nie potwierdzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureClean só lê arquivos de discos de rede quando você os analisa, por exemplo, para mostrar quais pastas enchem um disco compartilhado. Nada vai para o Lixo até você revisar e confirmar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean читает файлы на сетевых дисках, только когда вы их сканируете, например чтобы показать, какие папки занимают общий диск. Ничего не перемещается в Корзину, пока вы не просмотрите и не подтвердите это."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean läser bara filer på nätverksenheter när du skannar dem, till exempel för att visa vilka mappar som fyller en delad enhet. Ingenting flyttas till papperskorgen förrän du har granskat och bekräftat det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean อ่านไฟล์บนไดรฟ์เครือข่ายเฉพาะเมื่อคุณสแกนเท่านั้น เช่น เพื่อแสดงว่าโฟลเดอร์ใดใช้พื้นที่ไดรฟ์ที่แชร์ จะไม่มีสิ่งใดถูกย้ายไปที่ถังขยะจนกว่าคุณจะตรวจสอบและยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean, ağ disklerindeki dosyaları yalnızca siz onları taradığınızda okur; örneğin paylaşılan bir diski hangi klasörlerin doldurduğunu göstermek için. Siz gözden geçirip onaylamadan hiçbir şey Çöp Sepetine taşınmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean chỉ đọc tệp trên ổ đĩa mạng khi bạn quét chúng, ví dụ để cho biết thư mục nào đang làm đầy ổ đĩa dùng chung. Không có gì được chuyển vào Thùng rác cho đến khi bạn xem lại và xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 仅在你扫描网络驱动器时读取其中的文件，例如显示哪些文件夹占满了共享驱动器。在你检查并确认之前，不会有任何内容被移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 只會在你掃描網路磁碟時讀取其中的檔案，例如顯示哪些檔案夾佔滿了共享磁碟。在你檢查並確認之前，不會有任何項目被移到垃圾桶。"
          }
        }
      }
    },
    "NSRemovableVolumesUsageDescription" : {
      "comment" : "Permission prompt: external drives",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ PureClean الملفات الموجودة على الأقراص الخارجية فقط عندما تفحصها، مثلًا ليعرض المجلدات التي تملأ قرص USB. لا يُنقل أي شيء إلى سلة المهملات حتى تراجعه وتؤكده."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean læser kun filer på eksterne drev, når du scanner dem, for eksempel for at vise, hvilke mapper der fylder et USB-drev. Intet flyttes til papirkurven, før du har gennemgået og bekræftet det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean liest Dateien auf externen Laufwerken nur, wenn du sie scannst, zum Beispiel um zu zeigen, welche Ordner einen USB-Stick füllen. Nichts kommt in den Papierkorb, bevor du es geprüft und bestätigt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean reads files on external drives only when you scan them, for example to show which folders fill a USB drive. Nothing is moved to the Trash until you review and confirm it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean solo lee archivos de discos externos cuando los analizas, por ejemplo, para mostrar qué carpetas llenan una memoria USB. Nada se mueve a la Papelera hasta que lo revises y confirmes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean lukee ulkoisten levyjen tiedostoja vain, kun skannaat ne, esimerkiksi näyttääkseen, mitkä kansiot täyttävät USB-levyn. Mitään ei siirretä roskakoriin ennen kuin olet tarkistanut ja vahvistanut sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ne lit les fichiers des disques externes que lorsque vous les analysez, par exemple pour montrer quels dossiers remplissent une clé USB. Rien n’est placé dans la Corbeille avant que vous l’ayez vérifié et confirmé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean बाहरी ड्राइव की फ़ाइलें तभी पढ़ता है जब आप उन्हें स्कैन करते हैं, जैसे यह दिखाने के लिए कि USB ड्राइव किन फ़ोल्डरों से भरी है। जब तक आप समीक्षा करके पुष्टि नहीं करते, कुछ भी ट्रैश में नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean hanya membaca file di drive eksternal saat Anda memindainya, misalnya untuk menunjukkan folder mana yang memenuhi drive USB. Tidak ada yang dipindahkan ke Sampah sebelum Anda meninjau dan mengonfirmasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean legge i file dei dischi esterni solo quando li analizzi, per esempio per mostrare quali cartelle riempiono una chiavetta USB. Nulla viene spostato nel Cestino finché non lo hai controllato e confermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean は、外部ドライブのファイルをスキャンしたときにだけ読み取ります（USBドライブをどのフォルダが占めているかを表示するためなど）。確認して承認するまで、何もゴミ箱に移動されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean은 외장 드라이브를 스캔할 때만 해당 파일을 읽습니다(예: 어떤 폴더가 USB 드라이브를 채우고 있는지 보여 주기 위해). 검토하고 확인하기 전에는 아무것도 휴지통으로 이동하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean leser bare filer på eksterne disker når du skanner dem, for eksempel for å vise hvilke mapper som fyller en USB-disk. Ingenting flyttes til papirkurven før du har gått gjennom og bekreftet det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean leest bestanden op externe schijven alleen als je ze scant, bijvoorbeeld om te laten zien welke mappen een USB-stick vullen. Niets gaat naar de prullenmand voordat je het hebt bekeken en bevestigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean odczytuje pliki na dyskach zewnętrznych tylko wtedy, gdy je skanujesz, na przykład aby pokazać, które foldery zapełniają dysk USB. Nic nie trafia do kosza, dopóki tego nie przejrzysz i nie potwierdzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureClean só lê arquivos de discos externos quando você os analisa, por exemplo, para mostrar quais pastas enchem um pen drive. Nada vai para o Lixo até você revisar e confirmar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean читает файлы на внешних дисках, только когда вы их сканируете, например чтобы показать, какие папки занимают USB-накопитель. Ничего не перемещается в Корзину, пока вы не просмотрите и не подтвердите это."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean läser bara filer på externa enheter när du skannar dem, till exempel för att visa vilka mappar som fyller en USB-enhet. Ingenting flyttas till papperskorgen förrän du har granskat och bekräftat det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean อ่านไฟล์บนไดรฟ์ภายนอกเฉพาะเมื่อคุณสแกนเท่านั้น เช่น เพื่อแสดงว่าโฟลเดอร์ใดใช้พื้นที่ไดรฟ์ USB จะไม่มีสิ่งใดถูกย้ายไปที่ถังขยะจนกว่าคุณจะตรวจสอบและยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean, harici disklerdeki dosyaları yalnızca siz onları taradığınızda okur; örneğin bir USB belleği hangi klasörlerin doldurduğunu göstermek için. Siz gözden geçirip onaylamadan hiçbir şey Çöp Sepetine taşınmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean chỉ đọc tệp trên ổ đĩa ngoài khi bạn quét chúng, ví dụ để cho biết thư mục nào đang làm đầy ổ USB. Không có gì được chuyển vào Thùng rác cho đến khi bạn xem lại và xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 仅在你扫描外置驱动器时读取其中的文件，例如显示哪些文件夹占满了 U 盘。在你检查并确认之前，不会有任何内容被移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 只會在你掃描外接磁碟時讀取其中的檔案，例如顯示哪些檔案夾佔滿了 USB 隨身碟。在你檢查並確認之前，不會有任何項目被移到垃圾桶。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
