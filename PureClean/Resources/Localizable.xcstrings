        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 개인 파일은 정리 대상으로 자동 선택되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store personlige filer velges aldri automatisk for rydding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grote persoonlijke bestanden worden nooit automatisch geselecteerd voor opschonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duże pliki osobiste nigdy nie są automatycznie zaznaczane do czyszczenia."
