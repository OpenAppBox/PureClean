    "A visual map of the items listed in the table below. Use the table to navigate with the keyboard or VoiceOver." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة مرئية للعناصر المدرجة في الجدول أدناه. استخدم الجدول للتنقل بلوحة المفاتيح أو VoiceOver."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et visuelt kort over emnerne i tabellen nedenfor. Brug tabellen til at navigere med tastaturet eller VoiceOver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Übersichtskarte der Objekte in der Tabelle unten. Navigiere mit der Tastatur oder VoiceOver über die Tabelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mapa visual de los ítems de la tabla de abajo. Usa la tabla para navegar con el teclado o VoiceOver."
