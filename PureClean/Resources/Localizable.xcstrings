    "Packages installed into each JavaScript project, found by your last scan. A project needs them to run or build." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحزم المثبّتة في كل مشروع JavaScript، كما وجدها آخر فحص. يحتاجها المشروع للتشغيل أو البناء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakker installeret i hvert JavaScript-projekt, fundet af din seneste scanning. Et projekt har brug for dem for at køre eller blive bygget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakete, die in jedes JavaScript-Projekt installiert sind, gefunden von deinem letzten Scan. Ein Projekt braucht sie zum Ausführen oder Bauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquetes instalados en cada proyecto de JavaScript, encontrados en tu último análisis. Un proyecto los necesita para ejecutarse o compilarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuhunkin JavaScript-projektiin asennetut paketit, jotka viimeisin skannauksesi löysi. Projekti tarvitsee niitä toimiakseen tai kääntyäkseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquets installés dans chaque projet JavaScript, trouvés par votre dernière analyse. Un projet en a besoin pour s’exécuter ou se construire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर JavaScript प्रोजेक्ट में इंस्टॉल किए गए पैकेज, आपके पिछले स्कैन में मिले। प्रोजेक्ट को चलाने या बिल्ड करने के लिए इनकी ज़रूरत होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket yang diinstal di setiap proyek JavaScript, ditemukan oleh pemindaian terakhir Anda. Proyek memerlukannya untuk dijalankan atau di-build."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacchetti installati in ogni progetto JavaScript, trovati dalla tua ultima analisi. Un progetto ne ha bisogno per funzionare o compilare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のスキャンで見つかった、各 JavaScript プロジェクトにインストールされたパッケージです。プロジェクトの実行やビルドに必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 스캔에서 찾은, 각 JavaScript 프로젝트에 설치된 패키지입니다. 프로젝트를 실행하거나 빌드하려면 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakker installert i hvert JavaScript-prosjekt, funnet av den siste skanningen din. Et prosjekt trenger dem for å kjøre eller bygges."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakketten die in elk JavaScript-project zijn geïnstalleerd, gevonden door je laatste scan. Een project heeft ze nodig om te draaien of te bouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiety zainstalowane w każdym projekcie JavaScript, znalezione przez ostatni skan. Projekt potrzebuje ich do działania lub kompilacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacotes instalados em cada projeto JavaScript, encontrados na sua última análise. Um projeto precisa deles para rodar ou compilar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеты, установленные в каждый проект JavaScript, найденные последним сканированием. Они нужны проекту для работы или сборки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket som installerats i varje JavaScript-projekt, hittade av din senaste skanning. Ett projekt behöver dem för att köras eller byggas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แพ็กเกจที่ติดตั้งในแต่ละโปรเจกต์ JavaScript ซึ่งพบจากการสแกนครั้งล่าสุด โปรเจกต์ต้องใช้แพ็กเกจเหล่านี้ในการรันหรือบิลด์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son taramanızın bulduğu, her JavaScript projesine kurulmuş paketler. Bir proje çalışmak veya derlenmek için bunlara ihtiyaç duyar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói được cài trong từng dự án JavaScript, tìm thấy ở lần quét gần nhất. Dự án cần chúng để chạy hoặc build."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次扫描找到的、安装在每个 JavaScript 项目中的软件包。项目需要它们才能运行或构建。"
          }
        },
        "zh-Hant" : {
