    "%lld items (%@) are held back because their apps are running. Quit them and PureClean checks again by itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تعليق %lld عنصر (%@) لأن تطبيقاتها قيد التشغيل. أنهِها وسيعيد PureClean التحقق من تلقاء نفسه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld emner (%@) holdes tilbage, fordi deres apps er åbne. Afslut dem, så tjekker PureClean igen af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Objekte (%@) werden zurückgehalten, weil ihre Apps geöffnet sind. Beende sie, dann prüft PureClean von selbst erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld items (%2$@) are held back because their apps are running. Quit them and PureClean checks again by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ítems (%2$@) se retienen porque sus apps se están ejecutando. Ciérralas y PureClean volverá a comprobarlo por sí solo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kohdetta (%@) pidätetään, koska niiden apit ovat käynnissä. Lopeta ne, niin PureClean tarkistaa uudelleen itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments (%@) sont mis de côté car leurs apps sont ouvertes. Quittez-les et PureClean revérifie de lui-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld आइटम (%2$@) रोके गए हैं क्योंकि उनके ऐप्स चल रहे हैं। उन्हें बंद करें, PureClean ख़ुद फिर से जाँच लेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld item (%2$@) ditahan karena app-nya sedang berjalan. Tutup app tersebut dan PureClean akan memeriksa ulang dengan sendirinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi (%@) sono trattenuti perché le loro app sono aperte. Chiudile e PureClean ricontrolla da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 項目（%@）は、アプリが起動中のため保留されています。アプリを終了すると PureClean が自動的に再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 실행 중이므로 항목 %lld개(%@)가 보류되었습니다. 앱을 종료하면 PureClean이 자동으로 다시 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld objekter (%@) holdes tilbake fordi appene deres er åpne. Avslutt dem, så sjekker PureClean på nytt av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld onderdelen (%@) worden tegengehouden omdat hun apps geopend zijn. Stop ze en PureClean controleert zelf opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymane elementy: %lld (%@), bo ich aplikacje są otwarte. Zamknij je, a PureClean sam sprawdzi ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens (%@) estão retidos porque seus apps estão abertos. Encerre-os e o PureClean verifica de novo sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объектов отложено: %lld (%@), потому что их приложения открыты. Закройте их, и PureClean проверит снова сам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld objekt (%@) hålls kvar eftersom deras appar är öppna. Avsluta dem så kontrollerar PureClean igen av sig själv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld รายการ (%2$@) ถูกพักไว้เพราะแอปของรายการเหล่านี้กำลังทำงาน ออกจากแอปเหล่านั้นแล้ว PureClean จะตรวจสอบใหม่เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaları çalıştığı için %1$lld öğe (%2$@) bekletiliyor. Uygulamalardan çıktığınızda PureClean kendiliğinden yeniden denetler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mục (%2$@) đang được giữ lại vì ứng dụng của chúng đang chạy. Hãy thoát các ứng dụng đó, PureClean sẽ tự kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于相关应用正在运行，%lld 个项目（%@）被暂缓。退出这些应用后，PureClean 会自动重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於相關 App 正在執行，%lld 個項目（%@）暫緩處理。結束這些 App 後，PureClean 會自動重新檢查。"
          }
        }
      }
    },
