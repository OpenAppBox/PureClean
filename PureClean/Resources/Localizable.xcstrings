    "The explorer fills in when the scan finishes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمتلئ المستكشف عند انتهاء الفحص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udforskeren fyldes, når scanningen er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Explorer füllt sich, wenn der Scan fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El explorador se completa cuando termina el análisis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selain täyttyy, kun skannaus valmistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’explorateur se remplit quand l’analyse se termine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
