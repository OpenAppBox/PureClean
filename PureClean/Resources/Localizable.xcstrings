          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกโฟลเดอร์ส่วนตัวของคุณ (“%@”) เพื่อให้ PureClean วัดขนาดได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean’in ölçebilmesi için ana klasörünüzü (“%@”) seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn thư mục chính của bạn (“%@”) để PureClean có thể đo nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你的个人文件夹（“%@”），以便 PureClean 进行测量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇你的個人專屬檔案夾（「%@」），讓 PureClean 進行測量。"
          }
        }
      }
    },
    "Choose “%@” so PureClean can measure it. Only names, sizes and dates are read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «%@» حتى يتمكن PureClean من قياسه. لا تُقرأ إلا الأسماء والأحجام والتواريخ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg „%@“, så PureClean kan måle den. Kun navne, størrelser og datoer læses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „%@“, damit PureClean den Ordner messen kann. Es werden nur Namen, Größen und Daten gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
