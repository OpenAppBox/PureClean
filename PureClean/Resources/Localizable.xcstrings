    "Add a folder PureClean should skip, or right-click an item on any page and choose “Exclude”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مجلدًا ليتخطاه PureClean، أو انقر بزر الماوس الأيمن على عنصر في أي صفحة واختر «استثناء»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en mappe, som PureClean skal springe over, eller højreklik på et emne på en vilkårlig side, og vælg “Udelad”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Ordner hinzu, den PureClean überspringen soll, oder klicke auf einer beliebigen Seite mit der rechten Maustaste auf ein Objekt und wähle „Ausschließen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una carpeta que PureClean deba omitir, o haz clic con el botón derecho en un ítem de cualquier página y elige “Excluir”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kansio, jonka PureClean ohittaa, tai napsauta kohdetta oikealla millä tahansa sivulla ja valitse ”Jätä pois”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un dossier que PureClean doit ignorer, ou faites un clic droit sur un élément dans n’importe quelle page et choisissez « Exclure »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा फ़ोल्डर जोड़ें जिसे PureClean छोड़ दे, या किसी भी पेज पर किसी आइटम पर राइट-क्लिक करके “बाहर रखें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan folder yang harus dilewati PureClean, atau klik kanan item di halaman mana pun dan pilih “Kecualikan”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una cartella che PureClean deve ignorare, oppure fai clic destro su un elemento in qualsiasi pagina e scegli “Escludi”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean にスキップさせるフォルダを追加するか、任意のページで項目を右クリックして「除外」を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean이 건너뛸 폴더를 추가하거나, 아무 페이지에서나 항목을 오른쪽 클릭하고 “제외”를 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en mappe PureClean skal hoppe over, eller høyreklikk på et objekt på en hvilken som helst side og velg «Utelat»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een map toe die PureClean moet overslaan, of klik met de rechtermuisknop op een onderdeel op een willekeurige pagina en kies ‘Uitsluiten’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj folder, który PureClean ma pomijać, lub kliknij prawym przyciskiem element na dowolnej stronie i wybierz „Wyklucz”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma pasta que o PureClean deve ignorar, ou clique com o botão direito em um item de qualquer página e escolha “Ignorar”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте папку, которую PureClean должен пропускать, или нажмите правой кнопкой на объект на любой странице и выберите «Исключить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en mapp som PureClean ska hoppa över, eller högerklicka på ett objekt på valfri sida och välj ”Uteslut”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มโฟลเดอร์ที่ PureClean ควรข้าม หรือคลิกขวาที่รายการในหน้าใดก็ได้แล้วเลือก “ยกเว้น”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean’in atlaması gereken bir klasör ekleyin ya da herhangi bir sayfada bir öğeye sağ tıklayıp “Hariç Tut”u seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một thư mục mà PureClean nên bỏ qua, hoặc bấm chuột phải vào một mục trên bất kỳ trang nào và chọn “Loại trừ”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 PureClean 应跳过的文件夹，或在任意页面上右键点按项目并选择“排除”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 PureClean 應略過的檔案夾，或在任一頁面上按右鍵點選項目並選擇「排除」。"
          }
        }
      }
    },
