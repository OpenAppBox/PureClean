    "Moves every item of this cleanup that is still in the Trash back to where it was." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد كل عنصر من هذا التنظيف لا يزال في سلة المهملات إلى مكانه الأصلي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lægger hvert emne fra denne oprydning, der stadig ligger i papirkurven, tilbage, hvor det var."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt jedes Objekt dieser Bereinigung, das noch im Papierkorb ist, an seinen Ort zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve a su lugar cada ítem de esta limpieza que siga en la Papelera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauttaa paikalleen jokaisen tämän siivouksen kohteen, joka on yhä roskakorissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remet à son emplacement chaque élément de ce nettoyage encore dans la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्लीनअप का हर वह आइटम जो अब भी ट्रैश में है, उसकी पुरानी जगह पर वापस रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memindahkan setiap item pembersihan ini yang masih ada di Sampah kembali ke tempat asalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta al suo posto ogni elemento di questa pulizia ancora nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このクリーンアップの項目のうち、まだゴミ箱にあるものをすべて元の場所に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 정리에서 아직 휴지통에 있는 모든 항목을 원래 위치로 되돌립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger hvert objekt fra denne ryddingen som fortsatt ligger i papirkurven, tilbake der det var."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet elk onderdeel van deze opschoonactie dat nog in de prullenmand ligt terug op zijn plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkłada na miejsce każdy element tego czyszczenia, który nadal jest w koszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolve ao lugar original cada item desta limpeza que ainda estiver no Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает на место каждый объект этой очистки, который ещё лежит в Корзине."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger tillbaka varje objekt från den här rensningen som fortfarande ligger i papperskorgen där det var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายทุกรายการของการล้างครั้งนี้ที่ยังอยู่ในถังขยะกลับไปที่เดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu temizliğin hâlâ Çöp Sepetinde olan tüm öğelerini eski yerlerine taşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa mọi mục của lần dọn dẹp này còn trong Thùng rác trở lại vị trí cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此次清理中仍在废纸篓中的每个项目放回原处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此次清理中仍在垃圾桶裡的每個項目放回原位。"
          }
        }
      }
    },
    "Moves the whole folder to the Trash after review. You can put it back from History." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل المجلد بالكامل إلى سلة المهملات بعد المراجعة. يمكنك إرجاعه من السجل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter hele mappen til papirkurven efter gennemgang. Du kan lægge den tilbage fra Historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt nach der Prüfung den ganzen Ordner in den Papierkorb. Du kannst ihn über den Verlauf zurücklegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve toda la carpeta a la Papelera tras revisarla. Puedes devolverla desde el Historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtää koko kansion roskakoriin tarkistuksen jälkeen. Voit palauttaa sen Historiasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place le dossier entier dans la Corbeille après vérification. Vous pouvez le remettre depuis l’Historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समीक्षा के बाद पूरा फ़ोल्डर ट्रैश में ले जाता है। आप इसे इतिहास से वापस रख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memindahkan seluruh folder ke Sampah setelah ditinjau. Anda dapat mengembalikannya dari Riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta l’intera cartella nel Cestino dopo il controllo. Puoi ripristinarla dalla Cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認後、フォルダ全体をゴミ箱に入れます。履歴から戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검토 후 폴더 전체를 휴지통으로 이동합니다. 기록에서 되돌릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter hele mappen til papirkurven etter gjennomgang. Du kan legge den tilbake fra Logg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst de hele map na controle naar de prullenmand. Je kunt hem terugzetten via Geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po sprawdzeniu przenosi cały folder do kosza. Możesz go odłożyć z Historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a pasta inteira para o Lixo após a revisão. Você pode devolvê-la pelo Histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После проверки перемещает всю папку в Корзину. Её можно вернуть из Истории."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar hela mappen till papperskorgen efter granskning. Du kan lägga tillbaka den från Historik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายทั้งโฟลเดอร์ไปที่ถังขยะหลังตรวจทาน คุณย้ายกลับได้จากประวัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İncelemeden sonra klasörün tamamını Çöp Sepeti’ne taşır. Geçmiş’ten geri koyabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển toàn bộ thư mục vào Thùng rác sau khi xem lại. Bạn có thể đưa nó trở lại từ Lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查后将整个文件夹移到废纸篓。你可以从“历史”中放回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查後將整個檔案夾移到垃圾桶。你可以從「記錄」中放回。"
          }
        }
      }
    },
    "Moving items to the Trash does not free space. Space is released when you empty the Trash — PureClean never does that for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل العناصر إلى سلة المهملات لا يحرر مساحة. تتحرر المساحة عند إفراغ سلة المهملات — ولا يفعل PureClean ذلك نيابةً عنك أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At flytte emner til papirkurven frigør ikke plads. Pladsen frigøres, når du tømmer papirkurven – det gør PureClean aldrig for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte in den Papierkorb zu legen gibt keinen Platz frei. Der Platz wird frei, wenn du den Papierkorb entleerst – das macht PureClean nie für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover ítems a la Papelera no libera espacio. El espacio se libera al vaciar la Papelera — PureClean nunca lo hace por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteiden siirtäminen roskakoriin ei vapauta tilaa. Tila vapautuu, kun tyhjennät roskakorin – PureClean ei koskaan tee sitä puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer des éléments dans la Corbeille ne libère pas d’espace. L’espace est libéré quand vous videz la Corbeille — PureClean ne le fait jamais pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइटम को ट्रैश में ले जाने से जगह ख़ाली नहीं होती। जगह तब ख़ाली होती है जब आप ट्रैश ख़ाली करते हैं — PureClean यह आपके लिए कभी नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memindahkan item ke Sampah tidak mengosongkan ruang. Ruang dilepaskan saat Anda mengosongkan Sampah — PureClean tidak pernah melakukannya untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare elementi nel Cestino non libera spazio. Lo spazio si libera quando svuoti il Cestino — PureClean non lo fa mai al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目をゴミ箱に入れても容量は空きません。容量はゴミ箱を空にしたときに解放されます — PureClean がゴミ箱を空にすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 휴지통으로 이동해도 공간은 확보되지 않습니다. 공간은 휴지통을 비울 때 확보되며, PureClean은 휴지통을 비우지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å flytte objekter til papirkurven frigjør ikke plass. Plassen frigjøres når du tømmer papirkurven – det gjør PureClean aldri for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdelen naar de prullenmand verplaatsen maakt geen ruimte vrij. Ruimte komt vrij als je de prullenmand leegmaakt – PureClean doet dat nooit voor je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeniesienie elementów do kosza nie zwalnia miejsca. Miejsce jest zwalniane po opróżnieniu kosza — PureClean nigdy nie robi tego za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover itens para o Lixo não libera espaço. O espaço é liberado quando você esvazia o Lixo — o PureClean nunca faz isso por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещение объектов в Корзину не освобождает место. Место освобождается, когда вы очищаете Корзину, — PureClean никогда не делает этого за вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att flytta objekt till papperskorgen frigör inget utrymme. Utrymmet frigörs när du tömmer papperskorgen – det gör PureClean aldrig åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การย้ายรายการไปที่ถังขยะยังไม่ได้พื้นที่คืน พื้นที่จะว่างเมื่อคุณล้างถังขยะ — PureClean ไม่เคยทำให้คุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğeleri Çöp Sepetine taşımak alan açmaz. Alan, Çöp Sepetini boşalttığınızda serbest kalır — PureClean bunu asla sizin yerinize yapmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển các mục vào Thùng rác không giải phóng dung lượng. Dung lượng được giải phóng khi bạn dọn sạch Thùng rác — PureClean không bao giờ làm việc đó thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将项目移到废纸篓并不会释放空间。清倒废纸篓时才会释放空间 — PureClean 从不替你执行此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將項目移到垃圾桶並不會釋放空間。清空垃圾桶時才會釋放空間 — PureClean 絕不會幫你這麼做。"
          }
        }
      }
    },
