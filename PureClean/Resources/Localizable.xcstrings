    "Light or dark, and how much moves on screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاتح أو داكن، ومقدار الحركة على الشاشة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyst eller mørkt, og hvor meget der bevæger sig på skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hell oder dunkel – und wie viel sich auf dem Bildschirm bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro u oscuro, y cuánto se mueve en pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaalea tai tumma, ja kuinka paljon näytöllä liikkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clair ou sombre, et ce qui bouge à l’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइट या डार्क, और स्क्रीन पर कितनी हलचल हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terang atau gelap, dan seberapa banyak gerakan di layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiaro o scuro, e quanto si muove sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトかダークか、画面上の動きの量。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 또는 다크 모드, 화면의 움직임 정도."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyst eller mørkt, og hvor mye som beveger seg på skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht of donker, en hoeveel er op het scherm beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasny czy ciemny i ile porusza się na ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro ou escuro, e quanto se move na tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Светлое или тёмное оформление и сколько движения на экране."
          }
        },
        "sv" : {
          "stringUnit" : {
