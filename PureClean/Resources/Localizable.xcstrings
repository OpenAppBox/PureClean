    "Detailed history lets you put items back from the Trash later. When off, only dates, counts and sizes are recorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك السجل المفصّل إرجاع العناصر من سلة المهملات لاحقًا. عند إيقافه، لا تُسجَّل إلا التواريخ والأعداد والأحجام."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med detaljeret historik kan du lægge emner tilbage fra papirkurven senere. Når den er slået fra, gemmes kun datoer, antal og størrelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit detailliertem Verlauf kannst du Objekte später aus dem Papierkorb zurücklegen. Ist er aus, werden nur Daten, Anzahlen und Größen gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial detallado te permite devolver ítems desde la Papelera más adelante. Si está desactivado, solo se registran fechas, cantidades y tamaños."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityiskohtaisen historian avulla voit palauttaa kohteita roskakorista myöhemmin. Kun se ei ole päällä, tallennetaan vain päivämäärät, määrät ja koot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un historique détaillé permet de remettre plus tard des éléments depuis la Corbeille. Lorsqu’il est désactivé, seules les dates, les quantités et les tailles sont enregistrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विस्तृत इतिहास से आप बाद में ट्रैश से आइटम वापस रख सकते हैं। बंद होने पर सिर्फ़ तारीख़ें, संख्या और आकार दर्ज होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat terperinci memungkinkan Anda mengembalikan item dari Sampah nanti. Jika nonaktif, hanya tanggal, jumlah, dan ukuran yang dicatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia dettagliata ti permette di ripristinare in seguito gli elementi dal Cestino. Se è disattivata, vengono registrati solo date, conteggi e dimensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細な履歴を残すと、あとでゴミ箱から項目を戻せます。オフの場合は日付、件数、サイズだけが記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상세 기록을 남기면 나중에 휴지통에서 항목을 되돌릴 수 있습니다. 끄면 날짜, 개수, 크기만 기록됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med detaljert logg kan du legge tilbake objekter fra papirkurven senere. Når den er av, lagres bare datoer, antall og størrelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met gedetailleerde geschiedenis kun je onderdelen later uit de prullenmand terugzetten. Staat dit uit, dan worden alleen datums, aantallen en groottes vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczegółowa historia pozwala później odłożyć elementy z kosza. Gdy jest wyłączona, zapisywane są tylko daty, liczby i rozmiary."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico detalhado permite devolver itens do Lixo depois. Quando desativado, só datas, contagens e tamanhos são registrados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подробная история позволяет позже вернуть объекты из Корзины. Если она выключена, записываются только даты, количество и размеры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med detaljerad historik kan du lägga tillbaka objekt från papperskorgen senare. När den är av sparas bara datum, antal och storlekar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติแบบละเอียดช่วยให้คุณย้ายรายการกลับจากถังขยะได้ภายหลัง เมื่อปิดไว้ จะบันทึกเฉพาะวันที่ จำนวน และขนาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıntılı geçmiş, öğeleri daha sonra Çöp Sepetinden geri koymanızı sağlar. Kapalıyken yalnızca tarihler, sayılar ve boyutlar kaydedilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử chi tiết cho phép bạn đưa các mục trở lại từ Thùng rác sau này. Khi tắt, chỉ ghi lại ngày, số lượng và kích thước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详细历史让你之后可以将项目从废纸篓放回。关闭时只记录日期、数量和大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細記錄可讓你之後將項目從垃圾桶放回。關閉時只記錄日期、數量和大小。"
          }
        }
      }
    },
    "Detailed history was off for this operation, so file paths were not recorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان السجل المفصّل متوقفًا لهذه العملية، لذا لم تُسجَّل مسارات الملفات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljeret historik var slået fra for denne handling, så filstierne blev ikke gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Vorgang war der detaillierte Verlauf aus, daher wurden keine Dateipfade gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial detallado estaba desactivado en esta operación, así que no se registraron las rutas de los archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityiskohtainen historia ei ollut päällä tässä toiminnossa, joten tiedostopolkuja ei tallennettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique détaillé était désactivé pour cette opération : les chemins des fichiers n’ont pas été enregistrés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऑपरेशन के लिए विस्तृत इतिहास बंद था, इसलिए फ़ाइल पाथ दर्ज नहीं हुए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat terperinci nonaktif untuk operasi ini, jadi jalur file tidak dicatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia dettagliata era disattivata per questa operazione, quindi i percorsi dei file non sono stati registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作では詳細な履歴がオフだったため、ファイルのパスは記録されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업에서는 상세 기록이 꺼져 있어 파일 경로가 기록되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljert logg var av for denne handlingen, så filbanene ble ikke lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedetailleerde geschiedenis stond uit voor deze actie, dus de bestandspaden zijn niet vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej operacji szczegółowa historia była wyłączona, więc ścieżki plików nie zostały zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico detalhado estava desativado nesta operação, por isso os caminhos dos arquivos não foram registrados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой операции подробная история была выключена, поэтому пути к файлам не записаны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljerad historik var av för den här åtgärden, så filernas sökvägar sparades inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติแบบละเอียดปิดอยู่สำหรับการดำเนินการนี้ จึงไม่ได้บันทึกพาธของไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem sırasında ayrıntılı geçmiş kapalıydı; bu nedenle dosya yolları kaydedilmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử chi tiết đã tắt cho thao tác này nên đường dẫn tệp không được ghi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作未开启详细历史，因此没有记录文件路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作未開啟詳細記錄，因此沒有記錄檔案路徑。"
          }
        }
      }
    },
