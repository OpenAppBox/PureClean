        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे की तालिका के आइटम का विज़ुअल मैप। कीबोर्ड या VoiceOver से नेविगेट करने के लिए तालिका का इस्तेमाल करें।"
