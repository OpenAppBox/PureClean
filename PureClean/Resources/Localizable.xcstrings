        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean은 다시 시작할 때 언어를 전환합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean bytter språk når den startes på nytt."
