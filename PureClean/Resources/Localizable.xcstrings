    "Space returns when you empty the Trash. PureClean never empties it for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود المساحة عند إفراغ سلة المهملات. لا يفرغها PureClean نيابةً عنك أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pladsen kommer tilbage, når du tømmer papirkurven. PureClean tømmer den aldrig for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Platz wird frei, wenn du den Papierkorb entleerst. PureClean entleert ihn nie für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio vuelve cuando vacías la Papelera. PureClean nunca la vacía por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tila palautuu, kun tyhjennät roskakorin. PureClean ei koskaan tyhjennä sitä puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace est rendu quand vous videz la Corbeille. PureClean ne la vide jamais pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैश ख़ाली करने पर जगह वापस मिलती है। PureClean इसे आपके लिए कभी ख़ाली नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kembali saat Anda mengosongkan Sampah. PureClean tidak pernah mengosongkannya untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio torna quando svuoti il Cestino. PureClean non lo svuota mai al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量はゴミ箱を空にすると戻ります。PureClean がゴミ箱を空にすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간은 휴지통을 비우면 돌아옵니다. PureClean은 휴지통을 비우지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plassen kommer tilbake når du tømmer papirkurven. PureClean tømmer den aldri for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruimte komt terug als je de prullenmand leegmaakt. PureClean maakt hem nooit voor je leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce wróci po opróżnieniu kosza. PureClean nigdy go nie opróżnia za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço volta quando você esvazia o Lixo. O PureClean nunca o esvazia por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место вернётся, когда вы очистите Корзину. PureClean никогда не очищает её за вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrymmet kommer tillbaka när du tömmer papperskorgen. PureClean tömmer den aldrig åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่จะกลับมาเมื่อคุณล้างถังขยะ PureClean ไม่เคยล้างให้คุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alan, Çöp Sepetini boşalttığınızda geri gelir. PureClean sepeti asla sizin yerinize boşaltmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dung lượng được trả lại khi bạn dọn sạch Thùng rác. PureClean không bao giờ dọn thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清倒废纸篓后空间才会回来。PureClean 从不替你清倒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空垃圾桶後空間才會回來。PureClean 絕不會幫你清空。"
          }
        }
      }
    },
