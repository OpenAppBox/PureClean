    "Files of at least %@ not changed for over a year, largest first — often forgotten downloads, exports and disk images." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات لا يقل حجمها عن %@ ولم تتغير منذ أكثر من عام، الأكبر أولًا — غالبًا ما تكون تنزيلات وملفات مُصدَّرة وصور أقراص منسية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på mindst %@, der ikke er ændret i over et år, de største først – ofte glemte overførsler, eksporter og diskbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien ab %@, die seit über einem Jahr nicht geändert wurden, die größten zuerst – oft vergessene Downloads, Exporte und Disk-Images."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos de al menos %@ sin cambios desde hace más de un año, los más grandes primero — a menudo descargas, exportaciones e imágenes de disco olvidadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähintään %@ tiedostot, joita ei ole muutettu yli vuoteen, suurimmat ensin – usein unohtuneita latauksia, vientejä ja levytiedostoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers d’au moins %@ non modifiés depuis plus d’un an, les plus gros d’abord — souvent des téléchargements, exports et images disque oubliés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम %@ की फ़ाइलें जो एक साल से ज़्यादा समय से नहीं बदलीं, सबसे बड़ी पहले — अक्सर भूले हुए डाउनलोड, एक्सपोर्ट और डिस्क इमेज।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File minimal %@ yang tidak berubah selama lebih dari setahun, terbesar lebih dulu — sering kali unduhan, ekspor, dan image disk yang terlupakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File di almeno %@ non modificati da oltre un anno, i più grandi per primi — spesso download, esportazioni e immagini disco dimenticati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 年以上変更されていない %@ 以上のファイル（大きい順）— 忘れられたダウンロード、書き出し、ディスクイメージであることが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1년 넘게 변경되지 않은 %@ 이상의 파일(큰 순서) — 잊어버린 다운로드, 내보내기, 디스크 이미지인 경우가 많습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på minst %@ som ikke er endret på over ett år, de største først – ofte glemte nedlastinger, eksporter og diskbilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden vanaf %@ die meer dan een jaar niet zijn gewijzigd, de grootste eerst – vaak vergeten downloads, exports en schijfkopieën."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki od %@ niezmieniane od ponad roku, największe na początku — często zapomniane pobrane pliki, eksporty i obrazy dysków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos de pelo menos %@ sem alterações há mais de um ano, os maiores primeiro — muitas vezes downloads, exportações e imagens de disco esquecidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы от %@, не менявшиеся больше года, сначала самые крупные, — часто это забытые загрузки, экспорты и образы дисков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på minst %@ som inte ändrats på över ett år, de största först – ofta bortglömda hämtningar, exporter och skivavbilder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ตั้งแต่ %@ ขึ้นไปที่ไม่เปลี่ยนแปลงมากกว่าหนึ่งปี เรียงจากใหญ่ที่สุด — มักเป็นไฟล์ดาวน์โหลด ไฟล์ส่งออก และอิมเมจดิสก์ที่ถูกลืม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yıldan uzun süredir değişmemiş, en az %@ boyutundaki dosyalar, en büyükten başlayarak — çoğu zaman unutulmuş indirmeler, dışa aktarımlar ve disk görüntüleri."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp từ %@ trở lên không thay đổi hơn một năm, lớn nhất trước — thường là các bản tải về, bản xuất và ảnh đĩa bị lãng quên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 %@ 且超过一年未更改的文件，从大到小 — 通常是被遗忘的下载、导出和磁盘映像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 %@ 且超過一年未變更的檔案，由大到小 — 通常是被遺忘的下載項目、輸出檔和磁碟映像檔。"
          }
        }
      }
    },
