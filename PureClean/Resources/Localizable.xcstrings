    "None of the Xcode, simulator, package-manager, Docker or model-cache locations PureClean knows exist on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد على هذا الـ Mac أي من مواقع Xcode أو أجهزة المحاكاة أو مديري الحزم أو Docker أو ذاكرات النماذج المؤقتة التي يعرفها PureClean."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af de Xcode-, simulator-, pakkehåndterings-, Docker- eller modelcachesteder, PureClean kender, findes på denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keiner der Xcode-, Simulator-, Paketmanager-, Docker- oder Modell-Cache-Orte, die PureClean kennt, ist auf diesem Mac vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No existe en este Mac ninguna de las ubicaciones de Xcode, simuladores, gestores de paquetes, Docker o cachés de modelos que PureClean conoce."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään PureCleanin tuntemista Xcoden, simulaattorien, paketinhallinnan, Dockerin tai mallivälimuistin sijainneista ei ole tässä Macissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun des emplacements Xcode, simulateur, gestionnaire de paquets, Docker ou cache de modèles connus de PureClean n’existe sur ce Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean को ज्ञात Xcode, सिम्युलेटर, पैकेज मैनेजर, Docker या मॉडल-कैश का कोई भी स्थान इस Mac पर मौजूद नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada lokasi Xcode, simulator, pengelola paket, Docker, atau cache model yang dikenal PureClean di Mac ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna delle posizioni di Xcode, simulatori, gestori di pacchetti, Docker o cache di modelli che PureClean conosce esiste su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean が把握している Xcode、シミュレータ、パッケージマネージャ、Docker、モデルキャッシュの場所は、この Mac にはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean이 알고 있는 Xcode, 시뮬레이터, 패키지 관리자, Docker, 모델 캐시 위치가 이 Mac에 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av Xcode-, simulator-, pakkebehandler-, Docker- eller modellbufferstedene PureClean kjenner til, finnes på denne Macen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
