    "%@ of used space is outside the scanned locations (macOS, other users, snapshots, protected data). PureClean does not guess its contents." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقع %@ من المساحة المستخدمة خارج المواقع التي تم فحصها (macOS، والمستخدمون الآخرون، واللقطات، والبيانات المحمية). لا يخمّن PureClean محتوياتها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ af den brugte plads ligger uden for de scannede steder (macOS, andre brugere, øjebliksbilleder, beskyttede data). PureClean gætter ikke på, hvad der ligger der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ des belegten Speichers liegen außerhalb der gescannten Orte (macOS, andere Benutzer, Schnappschüsse, geschützte Daten). PureClean rät nicht, was dort liegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ del espacio usado está fuera de las ubicaciones analizadas (macOS, otros usuarios, instantáneas, datos protegidos). PureClean no adivina su contenido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ käytetystä tilasta on skannattujen sijaintien ulkopuolella (macOS, muut käyttäjät, tilannevedokset, suojatut tiedot). PureClean ei arvaile niiden sisältöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ d’espace utilisé se trouvent hors des emplacements analysés (macOS, autres utilisateurs, instantanés, données protégées). PureClean ne devine pas leur contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस्तेमाल हुई जगह में से %@ स्कैन किए गए स्थानों के बाहर है (macOS, अन्य उपयोगकर्ता, स्नैपशॉट, संरक्षित डेटा)। PureClean इसकी सामग्री का अनुमान नहीं लगाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ruang terpakai berada di luar lokasi yang dipindai (macOS, pengguna lain, snapshot, data yang dilindungi). PureClean tidak menebak isinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di spazio utilizzato si trovano fuori dalle posizioni analizzate (macOS, altri utenti, istantanee, dati protetti). PureClean non tira a indovinare cosa contengano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用済み容量のうち %@ はスキャン対象外の場所にあります（macOS、ほかのユーザ、スナップショット、保護されたデータ）。PureClean はその中身を推測しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용된 공간 중 %@은(는) 스캔한 위치 밖에 있습니다(macOS, 다른 사용자, 스냅샷, 보호된 데이터). PureClean은 그 내용을 추측하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ av den brukte plassen ligger utenfor de skannede stedene (macOS, andre brukere, øyeblikksbilder, beskyttede data). PureClean gjetter ikke hva som ligger der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ van de gebruikte ruimte ligt buiten de gescande locaties (macOS, andere gebruikers, momentopnamen, beschermde gegevens). PureClean gokt niet wat daar staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zajętego miejsca znajduje się poza przeskanowanymi lokalizacjami (macOS, inni użytkownicy, migawki, chronione dane). PureClean nie zgaduje, co tam jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ do espaço usado estão fora dos locais analisados (macOS, outros usuários, instantâneos, dados protegidos). O PureClean não tenta adivinhar o conteúdo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ занятого места находится вне просканированных мест (macOS, другие пользователи, снимки, защищённые данные). PureClean не гадает, что там хранится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ av det använda utrymmet ligger utanför de skannade platserna (macOS, andra användare, ögonblicksbilder, skyddade data). PureClean gissar inte vad som finns där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ที่ใช้ไป %@ อยู่นอกตำแหน่งที่สแกน (macOS, ผู้ใช้อื่น, สแนปช็อต, ข้อมูลที่ได้รับการป้องกัน) PureClean ไม่เดาว่าข้างในมีอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılan alanın %@ kadarı taranan konumların dışında (macOS, diğer kullanıcılar, anlık görüntüler, korunan veriler). PureClean bu alanın içeriğini tahmin etmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dung lượng đã dùng nằm ngoài các vị trí đã quét (macOS, người dùng khác, ảnh chụp nhanh, dữ liệu được bảo vệ). PureClean không đoán nội dung của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已用空间中有 %@ 位于扫描位置之外（macOS、其他用户、快照、受保护的数据）。PureClean 不会猜测其中的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用空間中有 %@ 位於掃描位置之外（macOS、其他使用者、快照、受保護的資料）。PureClean 不會猜測其中的內容。"
          }
        }
      }
    },
