    "PureClean has no notifications, login items or background activity. It only works while you use it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يملك PureClean إشعارات أو عناصر تسجيل دخول أو نشاطًا في الخلفية. يعمل فقط أثناء استخدامك له."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean har ingen meddelelser, login-emner eller baggrundsaktivitet. Den arbejder kun, mens du bruger den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean hat keine Mitteilungen, Anmeldeobjekte oder Hintergrundaktivität. Es arbeitet nur, während du es nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean no tiene notificaciones, ítems de inicio ni actividad en segundo plano. Solo funciona mientras lo usas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureCleanilla ei ole ilmoituksia, kirjautumiskohteita eikä taustatoimintaa. Se toimii vain, kun käytät sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean n’a ni notifications, ni éléments d’ouverture, ni activité en arrière-plan. Il ne fonctionne que pendant que vous l’utilisez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean में न सूचनाएँ हैं, न लॉगिन आइटम, न बैकग्राउंड गतिविधि। यह सिर्फ़ तभी काम करता है जब आप इसे इस्तेमाल करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean tidak memiliki notifikasi, item login, atau aktivitas latar belakang. PureClean hanya bekerja selama Anda menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean non ha notifiche, elementi di login né attività in background. Funziona solo mentre lo usi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean には通知、ログイン項目、バックグラウンド処理がありません。使っている間だけ動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean에는 알림, 로그인 항목, 백그라운드 활동이 없습니다. 사용하는 동안에만 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean har ingen varslinger, påloggingsobjekter eller bakgrunnsaktivitet. Den arbeider bare mens du bruker den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean heeft geen meldingen, inlogonderdelen of achtergrondactiviteit. Het werkt alleen terwijl je het gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean nie ma powiadomień, rzeczy otwieranych po zalogowaniu ani aktywności w tle. Działa tylko wtedy, gdy go używasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureClean não tem notificações, itens de início nem atividade em segundo plano. Ele só funciona enquanto você o usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У PureClean нет уведомлений, объектов входа и фоновой активности. Он работает, только пока вы им пользуетесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean har inga notiser, inloggningsobjekt eller bakgrundsaktivitet. Den arbetar bara medan du använder den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ไม่มีการแจ้งเตือน รายการเข้าสู่ระบบ หรือกิจกรรมเบื้องหลัง ทำงานเฉพาะตอนที่คุณใช้งานเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean’in bildirimi, oturum açma öğesi veya arka plan etkinliği yoktur. Yalnızca siz kullanırken çalışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean không có thông báo, mục đăng nhập hay hoạt động nền. Nó chỉ hoạt động khi bạn đang dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 没有通知、登录项或后台活动。它只在你使用时工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 沒有通知、登入項目或背景活動。它只在你使用時運作。"
          }
        }
      }
    },
    "PureClean never empties the Trash for you." : {
