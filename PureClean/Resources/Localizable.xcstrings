    "Move this app’s %@ to the Trash and keep the app. They are recreated when needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل %@ الخاص بهذا التطبيق إلى سلة المهملات مع الإبقاء على التطبيق. يُعاد إنشاؤه عند الحاجة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt appens %@ til papirkurven, og behold appen. De oprettes igen efter behov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %@ dieser App in den Papierkorb legen und die App behalten. Sie werden bei Bedarf neu angelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve %@ de esta app a la Papelera y conserva la app. Se vuelven a crear cuando hacen falta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä tämän apin kohde %@ roskakoriin ja säilytä appi. Ne luodaan tarvittaessa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
