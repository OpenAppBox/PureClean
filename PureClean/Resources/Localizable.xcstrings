          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐप के %@ को ट्रैश में ले जाएँ और ऐप रखें। ज़रूरत पड़ने पर ये फिर से बन जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
