    "Compares completed scans of the locations chosen at the time; changing scan locations changes the totals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن عمليات الفحص المكتملة للمواقع المختارة في حينه؛ وتغيير مواقع الفحص يغيّر الإجماليات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner færdige scanninger af de steder, der blev valgt dengang; ændrede scanningssteder ændrer totalerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht abgeschlossene Scans der damals gewählten Orte; andere Scanorte ändern die Summen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara análisis completados de las ubicaciones elegidas en ese momento; cambiar las ubicaciones de análisis cambia los totales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa silloin valittujen sijaintien valmiita skannauksia; skannaussijaintien muuttaminen muuttaa summia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare les analyses terminées des emplacements choisis à l’époque ; changer les emplacements d’analyse change les totaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस समय चुने गए स्थानों के पूरे हुए स्कैन की तुलना करता है; स्कैन स्थान बदलने से कुल योग बदल जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan pemindaian selesai dari lokasi yang dipilih saat itu; mengubah lokasi pemindaian mengubah totalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta le analisi completate delle posizioni scelte allora; cambiare le posizioni di analisi cambia i totali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当時選択していた場所の完了済みスキャンを比較します。スキャン対象を変えると合計も変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당시 선택한 위치의 완료된 스캔을 비교합니다. 스캔 위치를 바꾸면 합계도 바뀝니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner fullførte skanninger av stedene som ble valgt da; endrede skanningssteder endrer summene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijkt voltooide scans van de toen gekozen locaties; andere scanlocaties veranderen de totalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównuje ukończone skany lokalizacji wybranych w tamtym czasie; zmiana lokalizacji skanowania zmienia sumy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara análises concluídas dos locais escolhidos na época; mudar os locais de análise muda os totais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивает завершённые сканирования мест, выбранных в тот момент; при смене мест сканирования итоги меняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför slutförda skanningar av de platser som valdes då; ändrade skanningsplatser ändrar summorna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบการสแกนที่เสร็จสมบูรณ์ของตำแหน่งที่เลือกไว้ในขณะนั้น การเปลี่ยนตำแหน่งที่สแกนจะเปลี่ยนยอดรวม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sırada seçili konumların tamamlanmış taramalarını karşılaştırır; tarama konumlarını değiştirmek toplamları da değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh các lần quét đã hoàn tất của những vị trí được chọn lúc đó; thay đổi vị trí quét sẽ thay đổi tổng số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较当时所选位置的已完成扫描；更改扫描位置会改变总计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較當時所選位置的已完成掃描；更改掃描位置會改變總計。"
          }
        }
      }
    },
