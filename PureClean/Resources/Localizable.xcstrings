    },
    "Your home folder by default. It reads names, sizes and dates — never the contents of your files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد حسابك افتراضيًا. يقرأ الأسماء والأحجام والتواريخ — وليس محتويات ملفاتك أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som standard din hjemmemappe. Den læser navne, størrelser og datoer – aldrig indholdet af dine filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig dein Benutzerordner. Gelesen werden Namen, Größen und Daten – nie die Inhalte deiner Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu carpeta de inicio, de forma predeterminada. Lee nombres, tamaños y fechas — nunca el contenido de tus archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletuksena kotikansiosi. Se lukee nimet, koot ja päivämäärät – ei koskaan tiedostojesi sisältöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dossier de départ par défaut. Il lit les noms, tailles et dates — jamais le contenu de vos fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट रूप से आपका होम फ़ोल्डर। यह नाम, आकार और तारीख़ें पढ़ता है — कभी आपकी फ़ाइलों की सामग्री नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder Utama Anda secara default. Hanya membaca nama, ukuran, dan tanggal — tidak pernah isi file Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita la tua cartella Inizio. Legge nomi, dimensioni e date — mai il contenuto dei tuoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトではホームフォルダです。読み取るのは名前、サイズ、日付だけで、ファイルの内容は読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 홈 폴더입니다. 이름, 크기, 날짜만 읽으며 파일 내용은 읽지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjemmemappen din som standard. Den leser navn, størrelser og datoer – aldri innholdet i filene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard je thuismap. Het leest namen, groottes en datums – nooit de inhoud van je bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie Twój katalog domowy. Odczytywane są nazwy, rozmiary i daty — nigdy zawartość plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua pasta pessoal, por padrão. Ele lê nomes, tamanhos e datas — nunca o conteúdo dos seus arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию — ваша папка пользователя. Читаются имена, размеры и даты — никогда не содержимое файлов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din hemmapp som standard. Den läser namn, storlekar och datum – aldrig innehållet i dina filer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์ส่วนตัวของคุณโดยค่าเริ่มต้น อ่านชื่อ ขนาด และวันที่ — ไม่เคยอ่านเนื้อหาไฟล์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak ana klasörünüz. Adları, boyutları ve tarihleri okur — dosyalarınızın içeriğini asla okumaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định là thư mục chính của bạn. Chỉ đọc tên, kích thước và ngày — không bao giờ đọc nội dung tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认为你的个人文件夹。它读取名称、大小和日期 — 从不读取文件内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為你的個人專屬檔案夾。它讀取名稱、大小和日期 — 絕不讀取檔案內容。"
          }
        }
      }
    },
    "Your last scan covered your home folder. Apps, shared and system data, and other users’ files are outside it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شمل آخر فحص مجلد حسابك فقط. التطبيقات والبيانات المشتركة وبيانات النظام وملفات المستخدمين الآخرين خارجه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din seneste scanning omfattede din hjemmemappe. Apps, delte data og systemdata samt andre brugeres filer ligger uden for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein letzter Scan umfasste deinen Benutzerordner. Apps, gemeinsam genutzte und Systemdaten sowie Dateien anderer Benutzer liegen außerhalb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu último análisis abarcó tu carpeta de inicio. Las apps, los datos compartidos y del sistema y los archivos de otros usuarios quedan fuera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeisin skannaus kattoi kotikansiosi. Apit, jaetut ja järjestelmän tiedot sekä muiden käyttäjien tiedostot jäivät sen ulkopuolelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernière analyse portait sur votre dossier de départ. Les apps, les données partagées et système, et les fichiers des autres utilisateurs n’en font pas partie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पिछले स्कैन में आपका होम फ़ोल्डर शामिल था। ऐप्स, साझा और सिस्टम डेटा, और अन्य उपयोगकर्ताओं की फ़ाइलें इसके बाहर हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemindaian terakhir Anda mencakup folder utama Anda. App, data bersama dan sistem, serta file pengguna lain berada di luarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima analisi ha riguardato la cartella Inizio. App, dati condivisi e di sistema e file di altri utenti ne sono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のスキャンはホームフォルダが対象でした。App、共有データとシステムデータ、ほかのユーザのファイルは含まれていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 스캔은 홈 폴더만 대상으로 했습니다. 앱, 공유 및 시스템 데이터, 다른 사용자의 파일은 포함되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den siste skanningen dekket hjemmemappen din. Apper, delte data og systemdata og andre brukeres filer ligger utenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je laatste scan omvatte je thuismap. Apps, gedeelde en systeemgegevens en bestanden van andere gebruikers vallen daarbuiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnie skanowanie objęło katalog domowy. Aplikacje, dane współdzielone i systemowe oraz pliki innych użytkowników pozostały poza nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua última análise abrangeu sua pasta pessoal. Apps, dados compartilhados e do sistema e arquivos de outros usuários ficaram de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последнее сканирование охватило папку пользователя. Приложения, общие и системные данные, а также файлы других пользователей в него не вошли."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din senaste skanning omfattade din hemmapp. Appar, delad data och systemdata samt andra användares filer ligger utanför."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสแกนครั้งล่าสุดครอบคลุมโฟลเดอร์ส่วนตัวของคุณ แอป ข้อมูลที่ใช้ร่วมกันและข้อมูลระบบ รวมถึงไฟล์ของผู้ใช้อื่นอยู่นอกขอบเขตนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son taramanız ana klasörünüzü kapsadı. Uygulamalar, paylaşılan ve sistem verileri ile diğer kullanıcıların dosyaları bunun dışında kaldı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần quét gần nhất chỉ bao gồm thư mục chính của bạn. Ứng dụng, dữ liệu dùng chung và hệ thống, cùng tệp của người dùng khác nằm ngoài phạm vi đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次扫描仅包含你的个人文件夹。应用、共享数据和系统数据以及其他用户的文件不在其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次掃描僅包含你的個人專屬檔案夾。App、共享資料和系統資料以及其他使用者的檔案不在其中。"
          }
        }
      }
    },
    "Your launch agents with a missing program are listed under Orphaned Remnants, where you can move them to the Trash after review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدرج وكلاء التشغيل الخاصة بك التي يكون برنامجها مفقودًا ضمن البقايا اليتيمة، حيث يمكنك نقلها إلى سلة المهملات بعد المراجعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine startagenter med et manglende program vises under Forældreløse rester, hvor du kan flytte dem til papirkurven efter gennemgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Startagenten mit fehlendem Programm werden unter „Verwaiste Reste“ aufgeführt, wo du sie nach der Prüfung in den Papierkorb legen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus agentes de inicio cuyo programa falta aparecen en Restos huérfanos, donde puedes moverlos a la Papelera tras revisarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistysagenttisi, joiden ohjelma puuttuu, luetellaan kohdassa Orvot jäänteet, jossa voit siirtää ne roskakoriin tarkistuksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos agents de lancement dont le programme manque sont listés dans Restes orphelins, où vous pouvez les placer dans la Corbeille après vérification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जिन लॉन्च एजेंट का प्रोग्राम मौजूद नहीं है वे छूटे हुए अवशेष में दिखते हैं, जहाँ समीक्षा के बाद आप उन्हें ट्रैश में ले जा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen peluncuran Anda yang programnya tidak ada dicantumkan di Sisa Tertinggal, tempat Anda dapat memindahkannya ke Sampah setelah ditinjau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi agenti di avvio con un programma mancante sono elencati in Residui orfani, dove puoi spostarli nel Cestino dopo il controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プログラムが見つからない起動エージェントは「孤立した残りファイル」に表示され、確認後にゴミ箱に入れられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 없는 실행 에이전트는 삭제된 앱 잔여 파일에 표시되며, 검토 후 휴지통으로 이동할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startagentene dine med et manglende program vises under Foreldreløse rester, der du kan flytte dem til papirkurven etter gjennomgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je startagents met een ontbrekend programma staan bij Verweesde restanten, waar je ze na controle naar de prullenmand kunt verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje agenty uruchamiania z brakującym programem są wymienione w Osieroconych pozostałościach, gdzie po sprawdzeniu możesz przenieść je do kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus agentes de inicialização com programa ausente aparecem em Restos Órfãos, onde você pode movê-los para o Lixo após a revisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши агенты запуска с отсутствующей программой показаны в разделе «Осиротевшие остатки», откуда их можно переместить в Корзину после проверки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina startagenter med saknat program visas under Kvarlämnade rester, där du kan flytta dem till papperskorgen efter granskning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอเจนต์การเปิดใช้ของคุณที่ไม่มีโปรแกรมแล้วจะแสดงอยู่ในไฟล์ตกค้าง ซึ่งคุณย้ายไปที่ถังขยะได้หลังตรวจทาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programı eksik olan başlatma aracılarınız Sahipsiz Kalıntılar’da listelenir; orada inceledikten sonra Çöp Sepeti’ne taşıyabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tác nhân khởi chạy của bạn bị thiếu chương trình được liệt kê trong Tệp sót lại, nơi bạn có thể chuyển chúng vào Thùng rác sau khi xem lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程序缺失的启动代理列在“孤立残留”下，检查后可以将其移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程式遺失的啟動代理程式會列在「孤立殘留檔案」下，檢查後可將其移到垃圾桶。"
          }
        }
      }
    },
