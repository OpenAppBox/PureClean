    "Removes every stored scan index, coverage report and trend. Your files are not affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل كل فهارس الفحص المخزّنة وتقارير التغطية والاتجاهات. لا تتأثر ملفاتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle gemte scanningsindeks, dækningsrapporter og tendenser. Dine filer berøres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alle gespeicherten Scan-Indizes, Abdeckungsberichte und Verläufe. Deine Dateien sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los índices de análisis, informes de cobertura y tendencias guardados. Tus archivos no se ven afectados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa kaikki tallennetut skannausindeksit, kattavuusraportit ja trendit. Tiedostoihisi ei kosketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les index d’analyse, rapports de couverture et tendances enregistrés. Vos fichiers ne sont pas touchés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजे गए सभी स्कैन इंडेक्स, कवरेज रिपोर्ट और रुझान हटाता है। आपकी फ़ाइलों पर कोई असर नहीं पड़ता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus setiap indeks pemindaian, laporan cakupan, dan tren yang tersimpan. File Anda tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove tutti gli indici di analisi, i rapporti di copertura e le tendenze salvati. I tuoi file non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されているスキャンインデックス、カバレッジレポート、推移をすべて削除します。ファイルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 모든 스캔 색인, 범위 보고서 및 추세를 제거합니다. 파일에는 영향이 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle lagrede skanningsindekser, dekningsrapporter og trender. Filene dine berøres ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle opgeslagen scanindexen, dekkingsrapporten en trends. Je bestanden blijven onaangetast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa wszystkie zapisane indeksy skanowania, raporty pokrycia i trendy. Twoje pliki nie są naruszane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todos os índices de análise, relatórios de cobertura e tendências guardados. Seus arquivos não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все сохранённые индексы сканирования, отчёты о покрытии и тенденции. Ваши файлы не затрагиваются."
