    "Places PureClean skips when scanning or never proposes for cleanup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أماكن يتخطاها PureClean عند الفحص أو لا يقترحها للتنظيف أبدًا."
          }
        },
        "da" : {
