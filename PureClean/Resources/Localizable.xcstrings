    "Put Back" : {
      "comment" : "Action restoring a trashed item to its original location. Prefer the target-language Finder Put Back command name, and use the same name in its help text.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرجاع"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg tilbage"
          }
