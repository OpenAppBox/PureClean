    "Your cleanup history stays available, so you can still put items back from the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى سجل التنظيف متاحًا، لذا يمكنك إرجاع العناصر من سلة المهملات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din oprydningshistorik er stadig tilgængelig, så du kan lægge emner tilbage fra papirkurven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Bereinigungsverlauf bleibt verfügbar, du kannst Objekte also weiterhin aus dem Papierkorb zurücklegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial de limpieza sigue disponible, así que aún puedes devolver ítems desde la Papelera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siivoushistoriasi on yhä käytettävissä, joten voit edelleen palauttaa kohteita roskakorista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique de nettoyage reste disponible : vous pouvez toujours remettre des éléments depuis la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका क्लीनअप इतिहास उपलब्ध रहता है, इसलिए आप अब भी ट्रैश से आइटम वापस रख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat pembersihan Anda tetap tersedia, jadi Anda masih dapat mengembalikan item dari Sampah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia delle pulizie resta disponibile, quindi puoi ancora ripristinare gli elementi dal Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンアップの履歴は引き続き利用できるため、ゴミ箱から項目を戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리 기록은 계속 남아 있으므로 휴지통에서 항목을 되돌릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryddeloggen er fortsatt tilgjengelig, så du kan fortsatt legge tilbake objekter fra papirkurven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opschoongeschiedenis blijft beschikbaar, dus je kunt nog steeds onderdelen uit de prullenmand terugzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia czyszczenia pozostaje dostępna, więc nadal możesz odłożyć elementy z kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico de limpeza continua disponível, então você ainda pode devolver itens do Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История очистки остаётся доступной, поэтому вы по-прежнему можете вернуть объекты из Корзины."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din rensningshistorik finns kvar, så du kan fortfarande lägga tillbaka objekt från papperskorgen."
