        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ में “गति कम करें” चालू है, इसलिए एनिमेशन पहले से कम हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurangi Gerakan aktif di Pengaturan Sistem, jadi animasi sudah dikurangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci movimento è attivo in Impostazioni di Sistema, quindi le animazioni sono già ridotte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で「視差効果を減らす」がオンのため、アニメーションはすでに減っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 동작 줄이기가 켜져 있어 애니메이션이 이미 줄어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduser bevegelse er på i Systeminnstillinger, så animasjoner er allerede redusert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verminder beweging staat aan in Systeeminstellingen, dus animaties zijn al beperkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicz ruch jest włączone w Ustawieniach systemowych, więc animacje są już ograniczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir Movimento está ativado nos Ajustes do Sistema, então as animações já estão reduzidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
