    "At least one copy of each file is always kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ دائمًا بنسخة واحدة على الأقل من كل ملف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindst én kopi af hver fil beholdes altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von jeder Datei bleibt immer mindestens eine Kopie erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre se conserva al menos una copia de cada archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisesta tiedostosta säilytetään aina vähintään yksi kopio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins une copie de chaque fichier est toujours conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर फ़ाइल की कम से कम एक कॉपी हमेशा रखी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setidaknya satu salinan setiap file selalu disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di ogni file viene sempre mantenuta almeno una copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ファイルのコピーが少なくとも 1 つは必ず保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 파일의 사본 중 하나 이상은 항상 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minst én kopi av hver fil beholdes alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van elk bestand blijft altijd minstens één kopie bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej jedna kopia każdego pliku jest zawsze zachowywana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
