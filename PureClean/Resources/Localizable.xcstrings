    "%@ identified. Each item is checked again right before it is moved; anything that changed is skipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحديد %@. يُفحص كل عنصر مجددًا قبل نقله مباشرةً؛ ويُتخطّى أي شيء تغيّر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fundet. Hvert emne kontrolleres igen lige før det flyttes; det, der er ændret, springes over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gefunden. Jedes Objekt wird direkt vor dem Verschieben erneut geprüft; was sich geändert hat, wird übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identificados. Cada ítem se vuelve a comprobar justo antes de moverlo; lo que haya cambiado se omite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ löydetty. Jokainen kohde tarkistetaan uudelleen juuri ennen siirtoa; muuttuneet ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identifiés. Chaque élément est revérifié juste avant d’être déplacé ; tout ce qui a changé est ignoré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पहचाने गए। हर आइटम को ट्रैश में ले जाने से ठीक पहले फिर से जाँचा जाता है; जो बदल गया हो उसे छोड़ दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ teridentifikasi. Setiap item diperiksa lagi tepat sebelum dipindahkan; apa pun yang berubah dilewati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ individuati. Ogni elemento viene ricontrollato subito prima dello spostamento; ciò che è cambiato viene saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を検出しました。各項目は移動の直前に再確認され、変更されたものはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 확인됨. 각 항목은 이동 직전에 다시 확인되며, 변경된 항목은 건너뜁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funnet. Hvert objekt kontrolleres på nytt rett før det flyttes; det som er endret, hoppes over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gevonden. Elk onderdeel wordt vlak voor het verplaatsen opnieuw gecontroleerd; wat veranderd is, wordt overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaleziono %@. Każdy element jest ponownie sprawdzany tuż przed przeniesieniem; zmienione są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identificados. Cada item é verificado de novo logo antes de ser movido; o que tiver mudado é ignorado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
