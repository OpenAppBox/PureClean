        }
      }
    },
    "There is deliberately no “always clean automatically” option." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد عمدًا خيار «التنظيف التلقائي دائمًا»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er bevidst ingen mulighed for “ryd altid automatisk op”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Option „immer automatisch bereinigen“ gibt es bewusst nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A propósito, no hay ninguna opción de “limpiar siempre automáticamente”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoa ”siivoa aina automaattisesti” ei ole tarkoituksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe volontairement aucune option « toujours nettoyer automatiquement »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जान-बूझकर “हमेशा अपने-आप साफ़ करें” जैसा कोई विकल्प नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sengaja tidak ada opsi “selalu bersihkan otomatis”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di proposito non esiste un’opzione “pulisci sempre automaticamente”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「常に自動でクリーンアップ」というオプションはあえて用意していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“항상 자동으로 정리” 옵션은 의도적으로 제공하지 않습니다."
          }
        },
        "nb" : {
