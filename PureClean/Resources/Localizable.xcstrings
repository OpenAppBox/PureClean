    "Brings %@ to the front so you can quit it (⌘Q)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر %@ في المقدمة لتتمكن من إنهائه (⌘Q)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringer %@ frem, så du kan afslutte den (⌘Q)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holt %@ in den Vordergrund, damit du die App beenden kannst (⌘Q)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae %@ al frente para que puedas cerrarla (⌘Q)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo %@ etualalle, jotta voit lopettaa sen (⌘Q)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place %@ au premier plan pour que vous puissiez la quitter (⌘Q)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को सामने लाता है ताकि आप उसे बंद कर सकें (⌘Q)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membawa %@ ke depan agar Anda dapat menutupnya (⌘Q)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta %@ in primo piano così puoi chiuderla (⌘Q)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を最前面に表示します。終了するには ⌘Q を押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 앞으로 가져와 종료할 수 있게 합니다(⌘Q)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter %@ frem slik at du kan avslutte den (⌘Q)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haalt %@ naar voren zodat je de app kunt stoppen (⌘Q)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysuwa %@ na pierwszy plan, aby można ją było zakończyć (⌘Q)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traz o %@ para a frente para você encerrá-lo (⌘Q)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выводит %@ на передний план, чтобы вы могли завершить приложение (⌘Q)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
