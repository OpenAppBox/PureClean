    "Its logical size is much larger than the space it uses on disk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حجمه المنطقي أكبر بكثير من المساحة التي يشغلها على القرص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens logiske størrelse er meget større end den plads, den bruger på disken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine logische Größe ist viel größer als der Platz, den es auf dem Volume belegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su tamaño lógico es mucho mayor que el espacio que ocupa en el disco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
