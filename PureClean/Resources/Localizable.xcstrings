    "One yearly subscription includes every feature, all updates and support." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراك سنوي واحد يشمل كل الميزات وجميع التحديثات والدعم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ét årligt abonnement giver alle funktioner, alle opdateringer og support."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Jahresabo umfasst alle Funktionen, alle Updates und Support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una suscripción anual incluye todas las funciones, todas las actualizaciones y soporte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi vuositilaus sisältää kaikki ominaisuudet, kaikki päivitykset ja tuen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul abonnement annuel comprend toutes les fonctionnalités, toutes les mises à jour et l’assistance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक सालाना सदस्यता में सभी सुविधाएँ, सभी अपडेट और सहायता शामिल हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu langganan tahunan mencakup semua fitur, semua pembaruan, dan dukungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo abbonamento annuale include tutte le funzioni, tutti gli aggiornamenti e l’assistenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 つの年額サブスクリプションで、すべての機能、すべてのアップデート、サポートを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연간 구독 하나로 모든 기능, 모든 업데이트 및 지원을 이용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett årsabonnement gir alle funksjoner, alle oppdateringer og support."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén jaarabonnement bevat alle functies, alle updates en ondersteuning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna roczna subskrypcja obejmuje wszystkie funkcje, wszystkie uaktualnienia i wsparcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma única assinatura anual inclui todos os recursos, todas as atualizações e suporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна годовая подписка включает все функции, все обновления и поддержку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En årsprenumeration ger alla funktioner, alla uppdateringar och support."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสมัครรับรายปีเพียงรายการเดียวรวมทุกคุณสมบัติ การอัปเดตทั้งหมด และการสนับสนุน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir yıllık abonelik tüm özellikleri, tüm güncellemeleri ve desteği kapsar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một gói đăng ký hằng năm bao gồm mọi tính năng, tất cả bản cập nhật và hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个年度订阅即可使用所有功能、获得所有更新和支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個年度訂閱即可使用所有功能、取得所有更新和支援。"
          }
        }
      }
    },
    "Only byte-identical files are listed. You choose every copy to remove, and one copy of each file is always kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُدرج إلا الملفات المتطابقة بايتًا ببايت. أنت من يختار كل نسخة تُزال، ويُحتفظ دائمًا بنسخة واحدة من كل ملف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun filer, der er identiske byte for byte, vises. Du vælger hver kopi, der fjernes, og én kopi af hver fil beholdes altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur byte-identische Dateien aufgeführt. Du wählst jede Kopie, die entfernt wird, und von jeder Datei bleibt immer eine Kopie erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo aparecen archivos idénticos byte a byte. Tú eliges cada copia que se elimina, y siempre se conserva una copia de cada archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain tavu tavulta identtiset tiedostot luetellaan. Valitset itse jokaisen poistettavan kopion, ja jokaisesta tiedostosta säilytetään aina yksi kopio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les fichiers identiques octet par octet sont listés. Vous choisissez chaque copie à supprimer, et une copie de chaque fichier est toujours conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ बाइट-दर-बाइट एक जैसी फ़ाइलें दिखाई जाती हैं। हटाने वाली हर कॉपी आप चुनते हैं, और हर फ़ाइल की एक कॉपी हमेशा रखी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya file yang identik byte demi byte yang dicantumkan. Anda memilih setiap salinan yang dihapus, dan satu salinan setiap file selalu disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono elencati solo file identici byte per byte. Scegli tu ogni copia da rimuovere, e di ogni file viene sempre mantenuta una copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイト単位で同一のファイルだけを表示します。削除するコピーはすべてご自身で選び、各ファイルのコピーが必ず 1 つ保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바이트 단위로 동일한 파일만 표시됩니다. 제거할 사본은 모두 직접 선택하며, 각 파일의 사본 하나는 항상 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare filer som er identiske byte for byte, vises. Du velger hver kopi som fjernes, og én kopi av hver fil beholdes alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen byte voor byte identieke bestanden worden vermeld. Jij kiest elke kopie die verdwijnt, en van elk bestand blijft altijd één kopie bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazywane są tylko pliki identyczne co do bajtu. Każdą usuwaną kopię wybierasz sam, a jedna kopia każdego pliku jest zawsze zachowywana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só arquivos idênticos byte a byte são listados. Você escolhe cada cópia a remover, e uma cópia de cada arquivo é sempre mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показываются только побайтово одинаковые файлы. Каждую удаляемую копию выбираете вы, и одна копия каждого файла всегда сохраняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara byte för byte identiska filer visas. Du väljer varje kopia som tas bort, och en kopia av varje fil behålls alltid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเฉพาะไฟล์ที่เหมือนกันทุกไบต์ คุณเลือกเองว่าจะลบสำเนาใด และจะเก็บสำเนาของแต่ละไฟล์ไว้หนึ่งชุดเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bayt bayt özdeş dosyalar listelenir. Kaldırılacak her kopyayı siz seçersiniz ve her dosyanın bir kopyası her zaman korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ liệt kê các tệp giống hệt nhau từng byte. Bạn chọn từng bản cần xóa, và luôn giữ lại một bản của mỗi tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅列出逐字节相同的文件。要移除的每个副本都由你选择，每个文件始终保留一个副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅列出逐位元組相同的檔案。要移除的每個副本都由你選擇，每個檔案一律保留一個副本。"
          }
        }
      }
    },
    "Only items where every check agrees that the app is gone (“Likely”). Their settings go too, should you ever reinstall." : {
      "comment" : "Smart Clean leftovers option. Removing these items removes the old app settings now, so a later reinstall cannot reuse those settings. Reinstallation is not what removes them.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط العناصر التي تشير كل الفحوصات إلى أن تطبيقها لم يعد مثبّتًا («مرجّح»). تُزال إعدادات التطبيق أيضًا، ولن تكون متاحة إذا أعدت تثبيته لاحقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun emner, hvor alle kontroller tyder på, at appen ikke længere er installeret (“Sandsynlig”). Appens indstillinger fjernes også og vil ikke være tilgængelige, hvis du installerer den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Objekte, bei denen alle Prüfungen darauf hindeuten, dass die App nicht mehr installiert ist („Wahrscheinlich“). Auch ihre Einstellungen werden entfernt und stehen bei einer Neuinstallation nicht mehr zur Verfügung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los ítems para los que todas las comprobaciones indican que la app ya no está instalada (“Probable”). La limpieza también elimina sus ajustes, que ya no estarán disponibles si reinstalas la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain kohteet, joiden kaikki tarkistukset viittaavat siihen, ettei appia ole enää asennettu (”Todennäköinen”). Myös apin asetukset poistetaan, eivätkä ne ole käytettävissä, jos asennat apin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement les éléments pour lesquels toutes les vérifications indiquent que l’app n’est plus installée (« Probable »). Le nettoyage supprime aussi ses réglages : vous ne les retrouverez pas si vous réinstallez l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ वे आइटम जिनकी सभी जाँचों से संकेत मिलता है कि ऐप अब इंस्टॉल नहीं है (“संभावित”)। इन आइटम को साफ़ करने से ऐप की सेटिंग्ज़ भी हट जाती हैं; ऐप दोबारा इंस्टॉल करने पर पुरानी सेटिंग्ज़ उपलब्ध नहीं होंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya item yang menurut semua pemeriksaan app-nya sudah tidak terinstal (“Kemungkinan Besar”). Pembersihan ini juga menghapus pengaturan app, sehingga pengaturan lama tidak tersedia jika Anda menginstal ulang app tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo gli elementi per cui tutti i controlli indicano che l’app non è più installata (“Probabile”). Vengono rimosse anche le impostazioni dell’app, che non saranno più disponibili se la reinstalli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのチェックで、アプリがもうインストールされていないと判断された項目（「可能性大」）のみ。アプリの設定も削除されるため、再インストールしても以前の設定は引き継がれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 확인 결과가 앱이 더 이상 설치되어 있지 않음을 나타내는 항목(“가능성 높음”)만 포함합니다. 앱 설정도 함께 제거되므로 앱을 다시 설치해도 이전 설정을 사용할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare objekter der alle kontroller tyder på at appen ikke lenger er installert («Sannsynlig»). Appens innstillinger fjernes også og vil ikke være tilgjengelige hvis du installerer den på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen onderdelen waarbij alle controles erop wijzen dat de app niet meer is geïnstalleerd (‘Waarschijnlijk’). Ook de instellingen worden verwijderd en zijn bij een herinstallatie niet meer beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko elementy, dla których wszystkie testy wskazują, że aplikacja nie jest już zainstalowana („Prawdopodobne”). Jej ustawienia też zostaną usunięte i nie będą dostępne po ponownej instalacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente itens para os quais todas as verificações indicam que o app não está mais instalado (“Provável”). Os ajustes do app também são removidos e não estarão disponíveis se você o reinstalar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только объекты, для которых все проверки указывают, что приложение больше не установлено («Вероятно»). Его настройки тоже удаляются и не будут доступны при переустановке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast objekt där alla kontroller tyder på att appen inte längre är installerad (”Troligt”). Även appens inställningar tas bort och finns inte kvar om du installerar om appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะรายการที่ผลการตรวจสอบทุกข้อบ่งชี้ว่าแอปไม่ได้ติดตั้งอยู่แล้ว (“น่าจะใช่”) การล้างรายการเหล่านี้จะลบการตั้งค่าของแอปด้วย คุณจึงใช้การตั้งค่าเดิมไม่ได้หากติดตั้งแอปใหม่ในภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca tüm denetimlerin uygulamanın artık yüklü olmadığını gösterdiği öğeler (“Olası”). Bu öğeleri kaldırmak uygulamanın ayarlarını da kaldırır; uygulamayı yeniden yüklerseniz eski ayarlarınız kullanılamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ các mục mà mọi bước kiểm tra đều cho thấy ứng dụng không còn được cài (“Có khả năng cao”). Việc dọn dẹp cũng xóa cài đặt của ứng dụng, nên các cài đặt cũ sẽ không còn nếu bạn cài lại ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅包含所有检查都表明应用已不再安装的项目（“很可能”）。清理也会移除应用的设置，因此重新安装应用后将无法沿用原来的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅包含所有檢查都顯示 App 已不再安裝的項目（「很可能」）。清理也會移除 App 的設定，因此重新安裝 App 後將無法沿用原來的設定。"
          }
        }
      }
    },
