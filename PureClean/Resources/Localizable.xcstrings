    "PureClean shows its data for information only." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض PureClean هذه البيانات للعلم فقط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean viser disse data kun til orientering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean zeigt seine Daten nur zur Information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean muestra sus datos solo a título informativo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean näyttää nämä tiedot vain tiedoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
