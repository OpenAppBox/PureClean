    "Large personal files are never selected for cleanup automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحدَّد الملفات الشخصية الكبيرة للتنظيف تلقائيًا أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store personlige filer vælges aldrig automatisk til oprydning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große persönliche Dateien werden nie automatisch zur Bereinigung ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos personales grandes nunca se seleccionan automáticamente para limpiar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuria henkilökohtaisia tiedostoja ei koskaan valita siivottaviksi automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gros fichiers personnels ne sont jamais sélectionnés automatiquement pour le nettoyage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़ी निजी फ़ाइलें कभी अपने-आप क्लीनअप के लिए नहीं चुनी जातीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File pribadi yang besar tidak pernah dipilih otomatis untuk dibersihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file personali di grandi dimensioni non vengono mai selezionati automaticamente per la pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな個人ファイルがクリーンアップ対象として自動的に選ばれることはありません。"
