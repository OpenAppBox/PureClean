    "Leftovers of apps that are no longer installed — listed only when independent checks agree." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقايا تطبيقات لم تعد مثبّتة — لا تُدرج إلا عندما تتفق فحوصات مستقلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rester af apps, der ikke længere er installeret – vises kun, når uafhængige kontroller stemmer overens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste von Apps, die nicht mehr installiert sind – nur aufgeführt, wenn unabhängige Prüfungen übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restos de apps que ya no están instaladas — solo aparecen cuando comprobaciones independientes coinciden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enää asentamattomien appien jäänteet – näytetään vain, kun riippumattomat tarkistukset täsmäävät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restes d’apps qui ne sont plus installées — listés uniquement quand des vérifications indépendantes concordent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन ऐप्स के अवशेष जो अब इंस्टॉल नहीं हैं — सिर्फ़ तब दिखाए जाते हैं जब स्वतंत्र जाँचें सहमत हों।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisa app yang tidak lagi terinstal — hanya dicantumkan jika pemeriksaan independen sepakat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Residui di app non più installate — elencati solo quando controlli indipendenti concordano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールされなくなったアプリの残りファイル — 独立したチェックが一致した場合にのみ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 설치되어 있지 않은 앱의 잔여 파일 — 독립적인 확인 결과가 일치할 때만 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rester etter apper som ikke lenger er installert – vises bare når uavhengige kontroller stemmer overens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restanten van apps die niet meer geïnstalleerd zijn – alleen vermeld als onafhankelijke controles overeenkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostałości aplikacji, które nie są już zainstalowane — pokazywane tylko wtedy, gdy niezależne testy są zgodne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restos de apps que não estão mais instalados — listados só quando verificações independentes concordam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остатки приложений, которые больше не установлены, — показываются, только когда независимые проверки согласны."
          }
        },
        "sv" : {
