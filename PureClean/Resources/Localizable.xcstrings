        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ मापा गया · पहले जाँचें, सिर्फ़ वही हटाएँ जो आप चुनें"
          }
        },
        "id" : {
          "stringUnit" : {
