    "Reduce Motion is on in System Settings, so animations are already reduced." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار «تقليل الحركة» مفعّل في إعدادات النظام، لذا الحركة مقللة بالفعل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducer bevægelse er slået til i Systemindstillinger, så animationer er allerede reduceret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegung reduzieren“ ist in den Systemeinstellungen aktiviert, daher sind Animationen bereits reduziert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir movimiento está activado en Ajustes del Sistema, así que las animaciones ya están reducidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähennä liikettä on käytössä Järjestelmäasetuksissa, joten animaatioita on jo vähennetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire les animations est activé dans Réglages Système : les animations sont déjà réduites."
