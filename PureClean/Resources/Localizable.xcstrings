    "Choose “Applications” so PureClean can move apps you uninstall to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «التطبيقات» حتى يتمكن PureClean من نقل التطبيقات التي تلغي تثبيتها إلى سلة المهملات."
          }
        },
        "da" : {
