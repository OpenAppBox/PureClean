        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ैसला आपका — एक टैप से समीक्षा में जुड़ जाता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusan Anda — satu ketukan menambahkannya ke peninjauan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidi tu — un clic lo aggiunge alla verifica"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どれを含めるかはあなた次第 — ワンタップで確認に追加"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택은 사용자에게 — 한 번 탭하면 검토에 추가됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bestemmer – ett klikk legger det til i gjennomgangen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij beslist — één klik voegt het toe aan de controle"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ty decydujesz — jedno kliknięcie dodaje do przeglądu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você decide — um clique adiciona à revisão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решаете вы — одно нажатие добавляет к проверке"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bestämmer – ett klick lägger till det i granskningen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเป็นคนตัดสินใจ — แตะครั้งเดียวเพื่อเพิ่มในการตรวจทาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karar sizin — tek dokunuşla incelemeye eklenir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn quyết định — một lần chạm sẽ thêm vào phần xem lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由你决定 — 点按一下即可加入检查"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由你決定 — 按一下即可加入檢查"
          }
        }
      }
    },
    "Each item is checked again right before it moves. Anything that changed is skipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفحص كل عنصر مجددًا قبل نقله مباشرةً. ويُتخطّى أي شيء تغيّر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert emne kontrolleres igen lige før det flyttes. Det, der er ændret, springes over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Objekt wird direkt vor dem Verschieben erneut geprüft. Was sich geändert hat, wird übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ítem se vuelve a comprobar justo antes de moverse. Lo que haya cambiado se omite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen kohde tarkistetaan uudelleen juuri ennen siirtoa. Muuttuneet ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément est revérifié juste avant d’être déplacé. Tout ce qui a changé est ignoré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर आइटम को ट्रैश में ले जाए जाने से ठीक पहले फिर से जाँचा जाता है। जो बदल गया हो उसे छोड़ दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap item diperiksa lagi tepat sebelum dipindahkan. Apa pun yang berubah dilewati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento viene ricontrollato subito prima dello spostamento. Ciò che è cambiato viene saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目は移動の直前に再確認されます。変更されたものはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목은 이동 직전에 다시 확인됩니다. 변경된 항목은 건너뜁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert objekt kontrolleres på nytt rett før det flyttes. Det som er endret, hoppes over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk onderdeel wordt vlak voor het verplaatsen opnieuw gecontroleerd. Wat veranderd is, wordt overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy element jest ponownie sprawdzany tuż przed przeniesieniem. Zmienione są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item é verificado de novo logo antes de ser movido. O que tiver mudado é ignorado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый объект проверяется ещё раз прямо перед перемещением. Изменившиеся пропускаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje objekt kontrolleras igen precis innan det flyttas. Det som har ändrats hoppas över."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละรายการจะถูกตรวจสอบอีกครั้งก่อนย้ายทันที รายการใดที่เปลี่ยนไปจะถูกข้าม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her öğe taşınmadan hemen önce yeniden denetlenir. Değişen her şey atlanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi mục được kiểm tra lại ngay trước khi di chuyển. Mục nào đã thay đổi sẽ bị bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个项目在移动前都会再次检查。有变化的项目将被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個項目在搬移前都會再次檢查。有變更的項目會被略過。"
          }
        }
      }
    },
    "Each item lists the evidence connecting it to this app. Ambiguous items are never selected for you; shared and system-wide items are never removed with an app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسرد كل عنصر الأدلة التي تربطه بهذا التطبيق. لا تُحدَّد العناصر الغامضة نيابةً عنك أبدًا؛ ولا تُزال العناصر المشتركة أو التي على مستوى النظام مع أي تطبيق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert emne viser den dokumentation, der knytter det til denne app. Uklare emner vælges aldrig for dig; delte og systemdækkende emner fjernes aldrig sammen med en app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu jedem Objekt steht der Beleg, der es mit dieser App verbindet. Unklare Objekte werden nie für dich ausgewählt; geteilte und systemweite Objekte werden nie mit einer App entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ítem muestra las pruebas que lo vinculan a esta app. Los ítems ambiguos nunca se seleccionan por ti; los compartidos y los de todo el sistema nunca se eliminan con una app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisen kohteen kohdalla on näyttö, joka yhdistää sen tähän appiin. Epäselviä kohteita ei koskaan valita puolestasi; jaettuja ja järjestelmänlaajuisia kohteita ei koskaan poisteta apin mukana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément indique la preuve qui le relie à cette app. Les éléments incertains ne sont jamais sélectionnés pour vous ; les éléments partagés et ceux de tout le système ne sont jamais supprimés avec une app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर आइटम में वह सबूत दिखता है जो उसे इस ऐप से जोड़ता है। अस्पष्ट आइटम कभी आपके लिए नहीं चुने जाते; साझा और पूरे सिस्टम के आइटम कभी ऐप के साथ नहीं हटाए जाते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap item mencantumkan bukti yang menghubungkannya dengan app ini. Item yang ambigu tidak pernah dipilihkan untuk Anda; item bersama dan item seluruh sistem tidak pernah dihapus bersama app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento mostra la prova che lo collega a questa app. Gli elementi ambigui non vengono mai selezionati per te; gli elementi condivisi e di sistema non vengono mai rimossi con un’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目には、このアプリとの関連を示す根拠が表示されます。不明確な項目が自動で選択されることはなく、共有項目やシステム全体の項目がアプリと一緒に削除されることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목에는 이 앱과의 연관성을 보여 주는 근거가 표시됩니다. 불명확한 항목은 자동으로 선택되지 않으며, 공유 항목이나 시스템 전체 항목은 앱과 함께 제거되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert objekt viser belegget som knytter det til denne appen. Uklare objekter velges aldri for deg; delte og systemomfattende objekter fjernes aldri sammen med en app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij elk onderdeel staat het bewijs dat het aan deze app koppelt. Onduidelijke onderdelen worden nooit voor je geselecteerd; gedeelde en systeembrede onderdelen worden nooit met een app verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy każdym elemencie jest dowód wiążący go z tą aplikacją. Niejasne elementy nigdy nie są zaznaczane za Ciebie; elementy współdzielone i systemowe nigdy nie są usuwane z aplikacją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item mostra a evidência que o liga a este app. Itens incertos nunca são selecionados por você; itens compartilhados e de todo o sistema nunca são removidos com um app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого объекта указано доказательство связи с этим приложением. Неясные объекты никогда не выбираются за вас; общие и общесистемные объекты никогда не удаляются вместе с приложением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje objekt visar beläggen som kopplar det till den här appen. Oklara objekt markeras aldrig åt dig; delade och systemomfattande objekt tas aldrig bort med en app."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละรายการแสดงหลักฐานที่เชื่อมโยงกับแอปนี้ รายการที่ไม่ชัดเจนจะไม่ถูกเลือกให้คุณ รายการที่ใช้ร่วมกันและรายการระดับระบบจะไม่ถูกลบพร้อมแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her öğe, onu bu uygulamaya bağlayan kanıtları listeler. Belirsiz öğeler sizin yerinize asla seçilmez; paylaşılan ve sistem genelindeki öğeler bir uygulamayla birlikte asla kaldırılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi mục liệt kê bằng chứng liên kết nó với ứng dụng này. Các mục mơ hồ không bao giờ được chọn sẵn cho bạn; các mục dùng chung và toàn hệ thống không bao giờ bị xóa cùng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个项目都列出了将其与此应用关联的证据。不明确的项目永远不会替你选中；共享项目和系统范围项目永远不会随应用一起移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個項目都列出將其與此 App 關聯的證據。不明確的項目絕不會自動幫你選取；共用和系統層級的項目絕不會隨 App 一起移除。"
          }
        }
      }
    },
