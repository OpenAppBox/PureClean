    "This space returns when you empty the Trash in Finder (Finder ▸ Empty Trash). PureClean never empties it for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود هذه المساحة عند إفراغ سلة المهملات في Finder ‏(Finder ▸ إفراغ سلة المهملات). لا يفرغها PureClean نيابةً عنك أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pladsen frigøres, når du tømmer papirkurven i Finder (Finder ▸ Tøm papirkurv). PureClean tømmer den aldrig for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Platz wird frei, wenn du den Papierkorb im Finder leerst (Finder ▸ Papierkorb entleeren). PureClean leert ihn nie für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este espacio vuelve cuando vacías la Papelera en Finder (Finder ▸ Vaciar Papelera). PureClean nunca la vacía por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tila vapautuu, kun tyhjennät roskakorin Finderissa (Finder ▸ Tyhjennä roskakori). PureClean ei koskaan tyhjennä sitä puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet espace revient quand vous videz la Corbeille dans le Finder (Finder ▸ Vider la Corbeille). PureClean ne la vide jamais à votre place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder में ट्रैश ख़ाली करने पर यह जगह वापस मिलती है (Finder ▸ ट्रैश ख़ाली करें)। PureClean इसे आपके लिए कभी ख़ाली नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang ini kembali saat Anda mengosongkan Sampah di Finder (Finder ▸ Kosongkan Sampah). PureClean tidak pernah mengosongkannya untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo spazio torna quando svuoti il Cestino nel Finder (Finder ▸ Svuota il Cestino). PureClean non lo svuota mai al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この容量は、Finder でゴミ箱を空にすると戻ります（Finder ▸ ゴミ箱を空にする）。PureClean がゴミ箱を空にすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공간은 Finder에서 휴지통을 비우면 돌아옵니다(Finder ▸ 휴지통 비우기). PureClean은 휴지통을 비우지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plassen blir ledig når du tømmer papirkurven i Finder (Finder ▸ Tøm papirkurven). PureClean tømmer den aldri for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze ruimte komt vrij als je de prullenmand leegmaakt in de Finder (Finder ▸ Maak prullenmand leeg). PureClean maakt hem nooit voor je leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To miejsce wróci, gdy opróżnisz Kosz w Finderze (Finder ▸ Opróżnij Kosz). PureClean nigdy nie opróżnia go za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este espaço volta quando você esvazia o Lixo no Finder (Finder ▸ Esvaziar Lixo). O PureClean nunca o esvazia por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это место освободится, когда вы очистите Корзину в Finder (Finder ▸ Очистить Корзину). PureClean никогда не очищает её за вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrymmet frigörs när du tömmer papperskorgen i Finder (Finder ▸ Töm papperskorgen). PureClean tömmer den aldrig åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่นี้จะกลับมาเมื่อคุณล้างถังขยะใน Finder (Finder ▸ ล้างถังขยะ) PureClean ไม่เคยล้างให้คุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu alan Finder’da Çöp Sepeti’ni boşalttığınızda geri gelir (Finder ▸ Çöp Sepeti’ni Boşalt). PureClean onu sizin yerinize asla boşaltmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dung lượng này được trả lại khi bạn dọn sạch Thùng rác trong Finder (Finder ▸ Dọn sạch Thùng rác). PureClean không bao giờ dọn thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在访达中清倒废纸篓后，这些空间才会回来（访达 ▸ 清倒废纸篓）。PureClean 从不替你清倒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Finder 中清空垃圾桶後，這些空間才會回來（Finder ▸ 清空垃圾桶）。PureClean 絕不會幫你清空。"
          }
        }
      }
    },
