    "Smaller files are still counted in every total; they are summarized per folder to keep the index small and fast." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحسب الملفات الأصغر أيضًا في كل إجمالي؛ وتُلخَّص لكل مجلد للإبقاء على الفهرس صغيرًا وسريعًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre filer tælles stadig med i alle totaler; de opsummeres pr. mappe for at holde indekset lille og hurtigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere Dateien zählen weiterhin in jeder Summe; sie werden pro Ordner zusammengefasst, damit der Index klein und schnell bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos más pequeños siguen contando en cada total; se resumen por carpeta para que el índice sea pequeño y rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienemmät tiedostot lasketaan silti jokaiseen summaan; ne tiivistetään kansioittain, jotta indeksi pysyy pienenä ja nopeana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petits fichiers comptent dans chaque total ; ils sont résumés par dossier pour garder l’index petit et rapide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटी फ़ाइलें भी हर योग में गिनी जाती हैं; इंडेक्स को छोटा और तेज़ रखने के लिए उनका फ़ोल्डरवार सारांश बनता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang lebih kecil tetap dihitung di setiap total; file tersebut diringkas per folder agar indeks tetap kecil dan cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file più piccoli contano comunque in ogni totale; vengono riassunti per cartella per mantenere l’indice piccolo e veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さなファイルもすべての合計に含まれます。インデックスを小さく高速に保つため、フォルダごとにまとめています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 파일도 모든 합계에 포함됩니다. 색인을 작고 빠르게 유지하기 위해 폴더별로 요약됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre filer telles fortsatt i hver sum; de oppsummeres per mappe for å holde indeksen liten og rask."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere bestanden tellen gewoon mee in elk totaal; ze worden per map samengevat om de index klein en snel te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniejsze pliki nadal liczą się w każdej sumie; są podsumowywane per folder, aby indeks był mały i szybki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos menores continuam contando em todos os totais; eles são resumidos por pasta para manter o índice pequeno e rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мелкие файлы всё равно учитываются во всех итогах; они сводятся по папкам, чтобы индекс оставался небольшим и быстрым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre filer räknas fortfarande i varje summa; de sammanfattas per mapp för att hålla indexet litet och snabbt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ขนาดเล็กยังนับรวมในทุกยอด แต่สรุปไว้ตามโฟลเดอร์เพื่อให้ดัชนีเล็กและเร็ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük dosyalar yine de her toplamda sayılır; dizini küçük ve hızlı tutmak için klasör başına özetlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp nhỏ hơn vẫn được tính trong mọi tổng số; chúng được tóm tắt theo thư mục để chỉ mục gọn và nhanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较小的文件仍计入每个总计；它们按文件夹汇总，以保持索引小而快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較小的檔案仍會計入每個總計；它們會依檔案夾彙總，以保持索引小而快。"
          }
        }
      }
    },
