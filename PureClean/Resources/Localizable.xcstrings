            "state" : "translated",
            "value" : "अनुपलब्ध डिवाइस ऐसे रनटाइम के हैं जो अब इंस्टॉल नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat yang tidak tersedia milik runtime yang tidak lagi terinstal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi non disponibili appartengono a runtime non più installati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できないデバイスは、インストールされていないランタイムに属しています。"
