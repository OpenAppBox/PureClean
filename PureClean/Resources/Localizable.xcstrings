        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temizlik geçmişiniz kullanılabilir durumda kalır, böylece öğeleri Çöp Sepetinden hâlâ geri koyabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử dọn dẹp của bạn vẫn còn, nên bạn vẫn có thể đưa các mục trở lại từ Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的清理历史仍然保留，因此仍可将项目从废纸篓放回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的清理記錄仍會保留，因此仍可將項目從垃圾桶放回。"
