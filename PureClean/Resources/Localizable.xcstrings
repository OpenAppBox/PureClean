    "The first week is free. Cancel before it ends and you won't be charged." : {
      "comment" : "Subscribe screen: the 1-week free trial, shown smaller than the price and only to people eligible for it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
