          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの %@ をゴミ箱に入れ、アプリは残します。必要に応じて再作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
