    "Quit it before removing it or its data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِه قبل إزالته أو إزالة بياناته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut den, før du fjerner den eller dens data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende sie, bevor du sie oder ihre Daten entfernst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciérrala antes de eliminarla a ella o sus datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta se ennen sen tai sen tietojen poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez-la avant de la supprimer ou de supprimer ses données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे या इसके डेटा को हटाने से पहले इसे बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup app ini sebelum menghapusnya atau datanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudila prima di rimuovere l’app o i suoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリやそのデータを削除する前に、アプリを終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이나 그 데이터를 제거하기 전에 앱을 종료하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt den før du fjerner den eller dataene dens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de app voordat je hem of zijn gegevens verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ ją przed usunięciem jej lub jej danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre-o antes de removê-lo ou remover os dados dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершите его, прежде чем удалять его или его данные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta den innan du tar bort den eller dess data."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกจากแอปก่อนลบแอปหรือข้อมูลของแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı veya verilerini kaldırmadan önce uygulamadan çıkın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thoát ứng dụng trước khi xóa nó hoặc dữ liệu của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
