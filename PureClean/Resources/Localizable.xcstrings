    "Contains scan indexes (names, paths, sizes, dates), your exclusions and cleanup history. Nothing is ever transmitted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي على فهارس الفحص (الأسماء والمسارات والأحجام والتواريخ) والاستثناءات وسجل التنظيف. لا يُرسل أي شيء أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeholder scanningsindeks (navne, stier, størrelser, datoer), dine undtagelser og oprydningshistorikken. Intet sendes nogensinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält Scan-Indizes (Namen, Pfade, Größen, Daten), deine Ausschlüsse und den Bereinigungsverlauf. Es wird nie etwas übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene índices de análisis (nombres, rutas, tamaños, fechas), tus exclusiones y el historial de limpiezas. Nunca se transmite nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältää skannausindeksit (nimet, polut, koot, päivämäärät), poissulkemisesi ja siivoushistorian. Mitään ei koskaan lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contient les index d’analyse (noms, chemins, tailles, dates), vos exclusions et l’historique des nettoyages. Rien n’est jamais transmis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें स्कैन इंडेक्स (नाम, पाथ, आकार, तारीख़ें), आपके बाहर रखे गए स्थान और क्लीनअप इतिहास हैं। कुछ भी कभी भेजा नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berisi indeks pemindaian (nama, jalur, ukuran, tanggal), pengecualian Anda, dan riwayat pembersihan. Tidak ada yang pernah dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene gli indici delle analisi (nomi, percorsi, dimensioni, date), le tue esclusioni e la cronologia delle pulizie. Non viene mai trasmesso nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンインデックス（名前、パス、サイズ、日付）、除外設定、クリーンアップ履歴が含まれます。外部に送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 색인(이름, 경로, 크기, 날짜), 제외 항목 및 정리 기록이 들어 있습니다. 어떤 것도 전송되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inneholder skanningsindekser (navn, baner, størrelser, datoer), unntakene dine og ryddeloggen. Ingenting sendes noen gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevat scanindexen (namen, paden, groottes, datums), je uitzonderingen en de opschoongeschiedenis. Er wordt nooit iets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawiera indeksy skanowania (nazwy, ścieżki, rozmiary, daty), Twoje wykluczenia i historię czyszczenia. Nic nie jest wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contém índices de análise (nomes, caminhos, tamanhos, datas), suas exclusões e o histórico de limpezas. Nada é transmitido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Содержит индексы сканирования (имена, пути, размеры, даты), ваши исключения и историю очисток. Ничего никогда не передаётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehåller skanningsindex (namn, sökvägar, storlekar, datum), dina undantag och rensningshistoriken. Inget skickas någonsin."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีดัชนีการสแกน (ชื่อ พาธ ขนาด วันที่) รายการยกเว้น และประวัติการล้างของคุณ ไม่มีการส่งข้อมูลใดออกไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama dizinlerini (adlar, yollar, boyutlar, tarihler), hariç tuttuklarınızı ve temizlik geçmişini içerir. Hiçbir şey hiçbir yere gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chứa chỉ mục quét (tên, đường dẫn, kích thước, ngày), các mục loại trừ và lịch sử dọn dẹp của bạn. Không có gì được gửi đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含扫描索引（名称、路径、大小、日期）、你的排除项和清理历史。不会传输任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含掃描索引（名稱、路徑、大小、日期）、你的排除項目和清理記錄。不會傳送任何內容。"
          }
        }
      }
    },
