    "The tool downloads or rebuilds it the next time it’s needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد الأداة تنزيله أو بناءه في المرة القادمة التي تحتاج إليه فيها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værktøjet henter eller opretter det igen, næste gang det skal bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Werkzeug lädt oder erstellt es beim nächsten Bedarf neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta lo descarga o lo vuelve a generar la próxima vez que haga falta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työkalu lataa tai luo sen uudelleen, kun sitä seuraavan kerran tarvitaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil le retélécharge ou le recrée la prochaine fois qu’il en a besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली बार ज़रूरत पड़ने पर टूल इसे डाउनलोड करता है या फिर से बनाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alat itu mengunduh atau membuatnya ulang saat diperlukan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo strumento lo riscarica o lo ricrea la prossima volta che serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に必要になったとき、ツールが再ダウンロードまたは再作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 필요할 때 도구가 다시 다운로드하거나 다시 빌드합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøyet laster ned eller lager det på nytt neste gang det trengs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tool downloadt of maakt het opnieuw aan zodra het weer nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzie pobierze lub odtworzy to przy następnej potrzebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ferramenta baixa ou recria isto na próxima vez que precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструмент загрузит или создаст это заново, когда понадобится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktyget hämtar eller skapar det igen nästa gång det behövs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องมือจะดาวน์โหลดหรือสร้างใหม่เมื่อต้องใช้ครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç, bir sonraki ihtiyaçta bunu yeniden indirir veya oluşturur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
