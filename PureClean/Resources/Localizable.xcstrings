    "PureClean can’t scan “%@” without access to it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع PureClean فحص «%@» دون الوصول إليه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan ikke scanne „%@“ uden adgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kann „%@“ ohne Zugriff darauf nicht scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean no puede analizar “%@” sin acceso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ei voi skannata kohdetta ”%@” ilman käyttöoikeutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ne peut pas analyser « %@ » sans y avoir accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐक्सेस के बिना PureClean “%@” स्कैन नहीं कर सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean tidak dapat memindai “%@” tanpa akses ke sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean non può analizzare “%@” senza accedervi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean は “%@” へのアクセス権がないとスキャンできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean은 “%@”에 접근할 수 없으면 스캔할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan ikke skanne «%@» uten tilgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan ‘%@’ niet scannen zonder toegang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean nie może przeskanować „%@” bez dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureClean não consegue analisar “%@” sem acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean не может просканировать «%@» без доступа к ней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan inte skanna ”%@” utan åtkomst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean สแกน “%@” ไม่ได้หากไม่มีสิทธิ์เข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean, erişim izni olmadan “%@” klasörünü tarayamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean không thể quét “%@” khi không có quyền truy cập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 无法在没有访问权限的情况下扫描“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 無法在沒有取用權限的情況下掃描「%@」。"
          }
        }
      }
    },
    "PureClean can’t see which simulator runtimes are installed, so it can’t tell which devices are unavailable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع PureClean معرفة أوقات تشغيل المحاكاة المثبّتة، لذا لا يمكنه تحديد الأجهزة غير المتاحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan ikke se, hvilke kørselsmiljøer til simulatorer der er installeret, så den kan ikke afgøre, hvilke enheder der er utilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kann nicht sehen, welche Simulator-Laufzeiten installiert sind, und daher nicht erkennen, welche Geräte nicht verfügbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean no puede ver qué runtimes de simulador están instalados, así que no puede saber qué dispositivos no están disponibles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ei näe, mitkä simulaattorien ajoympäristöt on asennettu, joten se ei voi päätellä, mitkä laitteet eivät ole käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ne peut pas voir quels environnements d’exécution de simulation sont installés ; il ne peut donc pas savoir quels appareils sont indisponibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean यह नहीं देख सकता कि कौन-से सिम्युलेटर रनटाइम इंस्टॉल हैं, इसलिए वह नहीं बता सकता कि कौन-से डिवाइस अनुपलब्ध हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean tidak dapat melihat runtime simulator mana yang terinstal, jadi tidak dapat mengetahui perangkat mana yang tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean non può vedere quali runtime dei simulatori sono installati, quindi non può sapere quali dispositivi non sono disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean はどのシミュレータランタイムがインストールされているかを確認できないため、どのデバイスが利用不可かを判断できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean은 어떤 시뮬레이터 런타임이 설치되어 있는지 볼 수 없으므로 어떤 기기를 사용할 수 없는지 알 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan ikke se hvilke kjøremiljøer for simulatorer som er installert, og kan derfor ikke avgjøre hvilke enheter som er utilgjengelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kan niet zien welke simulatorruntimes zijn geïnstalleerd en kan dus niet bepalen welke apparaten niet beschikbaar zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean nie widzi, które środowiska wykonawcze symulatora są zainstalowane, więc nie może określić, które urządzenia są niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureClean não consegue ver quais runtimes de simulador estão instalados, então não consegue saber quais dispositivos estão indisponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean не видит, какие среды выполнения симулятора установлены, поэтому не может определить, какие устройства недоступны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
