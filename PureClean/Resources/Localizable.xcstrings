    "Unavailable devices belong to runtimes that are no longer installed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأجهزة غير المتاحة تنتمي إلى أوقات تشغيل لم تعد مثبّتة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilgængelige enheder hører til kørselsmiljøer, der ikke længere er installeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verfügbare Geräte gehören zu Laufzeiten, die nicht mehr installiert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos no disponibles pertenecen a runtimes que ya no están instalados."
