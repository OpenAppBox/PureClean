          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa analizza PureClean: la cartella Inizio o tutto il disco di avvio, incluse app, dati condivisi e altri file gestiti dal sistema."
