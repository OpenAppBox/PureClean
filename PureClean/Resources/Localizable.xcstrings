    "Reviewed, narrowly scoped rules for caches, logs and leftovers. Nothing is removed without your confirmation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قواعد مراجَعة ومحددة النطاق لذاكرات التخزين المؤقت والسجلات والبقايا. لا يُزال شيء دون تأكيدك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgåede, snævert afgrænsede regler for caches, logs og rester. Intet fjernes uden din bekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geprüfte, eng gefasste Regeln für Caches, Protokolle und Reste. Nichts wird ohne deine Bestätigung entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reglas revisadas y de alcance limitado para cachés, registros y restos. No se elimina nada sin tu confirmación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkastetut, tarkasti rajatut säännöt välimuisteille, lokeille ja jäänteille. Mitään ei poisteta ilman vahvistustasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des règles vérifiées et ciblées pour les caches, journaux et restes. Rien n’est supprimé sans votre confirmation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैश, लॉग और अवशेषों के लिए समीक्षित, सीमित दायरे वाले नियम। आपकी पुष्टि के बिना कुछ नहीं हटता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan yang ditinjau dan dibatasi ketat untuk cache, log, dan sisa. Tidak ada yang dihapus tanpa konfirmasi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regole verificate e mirate per cache, log e residui. Nulla viene rimosso senza la tua conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュ、ログ、残りファイルを対象に確認済みの、範囲を絞ったルールです。確定するまで何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시, 로그, 잔여 파일을 위한 검토된 좁은 범위의 규칙입니다. 확인 없이 제거되는 것은 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerte, snevert avgrensede regler for buffere, logger og rester. Ingenting fjernes uten din bekreftelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gecontroleerde, smal afgebakende regels voor caches, logs en restanten. Er wordt niets verwijderd zonder je bevestiging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzone, wąsko ograniczone reguły dla pamięci podręcznych, dzienników i pozostałości. Nic nie jest usuwane bez Twojego potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regras revisadas e bem delimitadas para caches, registros e restos. Nada é removido sem a sua confirmação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверенные, узко направленные правила для кэшей, журналов и остатков. Ничего не удаляется без вашего подтверждения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granskade, snävt avgränsade regler för cacheminnen, loggar och rester. Inget tas bort utan din bekräftelse."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กฎที่ตรวจทานแล้วและกำหนดขอบเขตแคบสำหรับแคช บันทึก และไฟล์ตกค้าง ไม่มีสิ่งใดถูกลบโดยไม่มีการยืนยันจากคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önbellekler, günlükler ve artıklar için incelenmiş, dar kapsamlı kurallar. Onayınız olmadan hiçbir şey kaldırılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
