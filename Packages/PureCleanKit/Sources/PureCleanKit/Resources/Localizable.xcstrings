            "state" : "translated",
            "value" : "ใช้ แอปพลิเคชัน → ถอนการติดตั้ง เพื่อลบแอปอย่างปลอดภัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaları güvenle kaldırmak için Uygulamalar → Kaldır’ı kullanın."
