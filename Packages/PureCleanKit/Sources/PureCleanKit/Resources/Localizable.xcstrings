    "Homebrew downloads packages again if you reinstall them. Alternatively run `brew cleanup`." : {
      "comment" : "Cleanup rule pkg.homebrew.downloads (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد Homebrew تنزيل الحزم إذا أعدت تثبيتها. ويمكنك بدلًا من ذلك تشغيل `brew cleanup`."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew henter pakker igen, hvis du geninstallerer dem. Du kan også køre `brew cleanup`."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew lädt Pakete neu, wenn du sie erneut installierst. Alternativ `brew cleanup` ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew vuelve a descargar los paquetes si los reinstalas. También puedes ejecutar `brew cleanup`."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew lataa paketit uudelleen, jos asennat ne uudelleen. Voit myös suorittaa komennon `brew cleanup`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew retélécharge les paquets si vous les réinstallez. Vous pouvez aussi exécuter `brew cleanup`."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोबारा इंस्टॉल करने पर Homebrew पैकेज फिर से डाउनलोड करता है। या `brew cleanup` चलाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew mengunduh paket lagi jika Anda menginstalnya ulang. Atau jalankan `brew cleanup`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew riscarica i pacchetti se li reinstalli. In alternativa esegui `brew cleanup`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再インストールすると Homebrew はパッケージを再ダウンロードします。代わりに `brew cleanup` を実行することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 설치하면 Homebrew가 패키지를 다시 다운로드합니다. 대신 `brew cleanup`을 실행할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew laster ned pakker på nytt hvis du installerer dem på nytt. Du kan også kjøre `brew cleanup`."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew downloadt pakketten opnieuw als je ze opnieuw installeert. Je kunt ook `brew cleanup` uitvoeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew pobierze pakiety ponownie, jeśli je ponownie zainstalujesz. Możesz też uruchomić `brew cleanup`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
