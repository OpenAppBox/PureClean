    "The copy that would be kept is gone or changed since the duplicate search. Search again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخة التي كان سيُحتفظ بها زالت أو تغيّرت منذ البحث عن المكررات. ابحث مجددًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kopi, der skulle beholdes, er væk eller ændret siden dubletsøgningen. Søg igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie, die behalten würde, ist seit der Duplikatsuche verschwunden oder geändert. Suche erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia que se conservaría ya no está o cambió desde la búsqueda de duplicados. Busca de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytettävä kopio on kadonnut tai muuttunut kaksoiskappalehaun jälkeen. Hae uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie qui serait conservée a disparu ou changé depuis la recherche de doublons. Recherchez à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो कॉपी रखी जानी थी वह डुप्लिकेट खोज के बाद से मौजूद नहीं है या बदल गई है। फिर से खोजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan yang akan disimpan sudah tidak ada atau berubah sejak pencarian duplikat. Cari lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia che verrebbe tenuta è sparita o cambiata dalla ricerca dei duplicati. Cerca di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持する予定だったコピーが、重複の検索後に消えたか変更されました。もう一度検索してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유지할 사본이 중복 검색 이후에 사라졌거나 변경되었습니다. 다시 검색하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien som skulle beholdes, er borte eller endret siden duplikatsøket. Søk på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kopie die bewaard zou worden, is sinds de duplicaatzoekactie verdwenen of gewijzigd. Zoek opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
