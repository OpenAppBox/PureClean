    "PureClean could not record what happened to %@, so it stopped before the remaining items. (%@)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على PureClean تسجيل ما حدث لـ %1$@، لذا توقّف قبل العناصر المتبقية. (%2$@)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kunne ikke registrere, hvad der skete med %1$@, så det stoppede før de resterende emner. (%2$@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean konnte nicht protokollieren, was mit %1$@ geschehen ist, und hat vor den übrigen Objekten angehalten. (%2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean no pudo registrar qué pasó con %1$@, así que se detuvo antes de procesar los ítems restantes. (%2$@)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ei voinut kirjata, mitä kohteelle %1$@ tapahtui, joten se pysähtyi ennen jäljellä olevia kohteita. (%2$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean n’a pas pu enregistrer ce qu’il est advenu de %1$@ et s’est arrêté avant les éléments restants. (%2$@)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean दर्ज नहीं कर सका कि %1$@ के साथ क्या हुआ, इसलिए शेष आइटम पर कार्रवाई करने से पहले रुक गया। (%2$@)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean tidak dapat mencatat apa yang terjadi pada %1$@, jadi berhenti sebelum memproses item yang tersisa. (%2$@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean non è riuscito a registrare cosa è successo a %1$@, quindi si è fermato prima degli elementi rimanenti. (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean は %1$@ の処理結果を記録できなかったため、残りの項目の前で停止しました。（%2$@）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean이 %1$@의 처리 결과를 기록하지 못해 남은 항목 전에 중지했습니다. (%2$@)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kunne ikke registrere hva som skjedde med %1$@, så det stoppet før de gjenværende objektene. (%2$@)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kon niet vastleggen wat er met %1$@ is gebeurd en is gestopt vóór de overige onderdelen. (%2$@)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean nie mógł zapisać, co stało się z %1$@, więc zatrzymał się przed pozostałymi elementami. (%2$@)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureClean não conseguiu registrar o que aconteceu com %1$@, então parou antes dos itens restantes. (%2$@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean не смог записать, что произошло с %1$@, и остановился перед оставшимися объектами. (%2$@)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kunde inte registrera vad som hände med %1$@, så det stoppade före de återstående objekten. (%2$@)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean บันทึกไม่ได้ว่าเกิดอะไรขึ้นกับ %1$@ จึงหยุดก่อนดำเนินการกับรายการที่เหลือ (%2$@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean %1$@ için ne olduğunu kaydedemedi, bu yüzden kalan öğelerden önce durdu. (%2$@)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean không thể ghi lại điều gì đã xảy ra với %1$@, nên đã dừng trước khi xử lý các mục còn lại. (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 无法记录 %1$@ 的处理结果，因此在剩余项目之前停止。（%2$@）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean 無法記錄 %1$@ 的處理結果，因此在其餘項目之前停止。（%2$@）"
          }
        }
      }
    },
    "PureClean could not save the history for this cleanup, so nothing was moved. (%@)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على PureClean حفظ سجل هذا التنظيف، لذا لم يُنقل أي شيء. (%@)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean kunne ikke gemme historikken for denne oprydning, så intet blev flyttet. (%@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean konnte den Verlauf dieser Bereinigung nicht speichern, daher wurde nichts verschoben. (%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean no pudo guardar el historial de esta limpieza, así que no se movió nada. (%@)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean ei voinut tallentaa tämän siivouksen historiaa, joten mitään ei siirretty. (%@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean n’a pas pu enregistrer l’historique de ce nettoyage : rien n’a été déplacé. (%@)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean इस क्लीनअप का इतिहास नहीं सहेज सका, इसलिए कोई आइटम नहीं ले जाया गया। (%@)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureClean tidak dapat menyimpan riwayat pembersihan ini, jadi tidak ada yang dipindahkan. (%@)"
          }
        },
        "it" : {
