            "state" : "translated",
            "value" : "Gebruik Programma's → Verwijder om apps veilig te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby bezpiecznie usuwać aplikacje, użyj Aplikacje → Odinstaluj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
