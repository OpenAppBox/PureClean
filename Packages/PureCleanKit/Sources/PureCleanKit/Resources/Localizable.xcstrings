    "Xcode copies symbols again the next time you connect that device, which can take several minutes." : {
      "comment" : "Cleanup rule dev.xcode.devicesupport (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
