          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode kopierer symbolerne igen, næste gang du tilslutter enheden, hvilket kan tage flere minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode kopiert die Symbole erneut, wenn du das Gerät wieder verbindest, was einige Minuten dauern kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode vuelve a copiar los símbolos la próxima vez que conectes ese dispositivo, lo que puede tardar varios minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode kopioi symbolit uudelleen, kun seuraavan kerran liität laitteen, mikä voi kestää useita minuutteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode recopie les symboles la prochaine fois que vous connectez cet appareil, ce qui peut prendre plusieurs minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली बार वह डिवाइस जोड़ने पर Xcode सिंबल फिर से कॉपी करता है, जिसमें कई मिनट लग सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode menyalin simbol lagi saat Anda menghubungkan perangkat itu berikutnya, yang dapat memakan waktu beberapa menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode ricopia i simboli la prossima volta che colleghi quel dispositivo, il che può richiedere alcuni minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次にそのデバイスを接続したときに Xcode がシンボルを再コピーします。数分かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 해당 기기를 연결하면 Xcode가 심볼을 다시 복사하며, 몇 분 정도 걸릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode kopierer symbolene på nytt neste gang du kobler til enheten, noe som kan ta flere minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode kopieert de symbolen opnieuw zodra je dat apparaat weer verbindt, wat enkele minuten kan duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode ponownie skopiuje symbole przy następnym podłączeniu tego urządzenia, co może potrwać kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Xcode copia os símbolos de novo na próxima vez que você conectar esse dispositivo, o que pode levar alguns minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode снова скопирует символы при следующем подключении этого устройства, что может занять несколько минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
