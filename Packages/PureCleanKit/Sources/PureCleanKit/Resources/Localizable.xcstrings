    "It belongs to another user or the system; removing it needs an administrator." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتمي إلى مستخدم آخر أو إلى النظام؛ وتتطلب إزالته مسؤولًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
