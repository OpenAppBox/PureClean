    "Check for processes with sustained high CPU, improve ventilation, and avoid soft surfaces." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من العمليات ذات الاستخدام المرتفع والمستمر للمعالج، وحسّن التهوية، وتجنب الأسطح اللينة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se efter processer med vedvarende høj CPU, sørg for bedre ventilation, og undgå bløde underlag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach Prozessen mit dauerhaft hoher CPU-Last, sorge für bessere Belüftung und vermeide weiche Unterlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca procesos con un uso alto y sostenido de la CPU, mejora la ventilación y evita superficies blandas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi prosesseja, joiden suoritinkäyttö on jatkuvasti korkea, paranna ilmanvaihtoa ja vältä pehmeitä alustoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez des processus au CPU élevé en continu, améliorez la ventilation et évitez les surfaces molles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार ज़्यादा CPU वाले प्रोसेस जाँचें, हवा का प्रवाह बेहतर करें और नरम सतहों से बचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa proses dengan CPU tinggi yang berkelanjutan, perbaiki ventilasi, dan hindari permukaan lunak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca processi con CPU alta costante, migliora la ventilazione ed evita le superfici morbide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 使用率が高い状態が続くプロセスを確認し、通気をよくし、柔らかい場所に置かないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 사용량이 계속 높은 프로세스를 확인하고, 통풍을 개선하며, 부드러운 표면 위에 두지 마십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se etter prosesser med vedvarende høy CPU, sørg for bedre ventilasjon og unngå myke underlag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek naar processen met aanhoudend hoge CPU, zorg voor betere ventilatie en vermijd zachte ondergronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź procesy o stale wysokim użyciu CPU, popraw wentylację i unikaj miękkich powierzchni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure processos com CPU alta constante, melhore a ventilação e evite superfícies macias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте процессы с постоянно высокой нагрузкой на ЦП, улучшите вентиляцию и не ставьте Mac на мягкие поверхности."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leta efter processer med ihållande hög CPU, förbättra ventilationen och undvik mjuka underlag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจหาโปรเซสที่ใช้ CPU สูงต่อเนื่อง ปรับการระบายอากาศ และหลีกเลี่ยงการวางบนพื้นผิวนุ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürekli yüksek CPU kullanan işlemleri denetleyin, havalandırmayı iyileştirin ve yumuşak yüzeylerden kaçının."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra các tiến trình dùng CPU cao liên tục, cải thiện thông gió và tránh đặt máy trên bề mặt mềm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查是否有持续高 CPU 占用的进程，改善通风，并避免放在柔软表面上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查是否有持續高 CPU 用量的程序、改善通風，並避免放在柔軟表面上。"
          }
        }
      }
    },
    "Chrome's per-profile web cache (not bookmarks, passwords or history, which live in Application Support)." : {
