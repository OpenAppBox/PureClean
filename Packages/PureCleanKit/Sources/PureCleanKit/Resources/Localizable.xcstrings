    "Simulators can hold test data and app state. Remove devices with Xcode or `xcrun simctl`, not by deleting folders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحتوي أجهزة المحاكاة على بيانات اختبار وحالة التطبيقات. أزِل الأجهزة باستخدام Xcode أو `xcrun simctl`، وليس بحذف المجلدات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulatorer kan indeholde testdata og apptilstand. Fjern enheder med Xcode eller `xcrun simctl`, ikke ved at slette mapper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulatoren können Testdaten und App-Zustand enthalten. Entferne Geräte mit Xcode oder `xcrun simctl`, nicht durch Löschen von Ordnern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los simuladores pueden contener datos de prueba y el estado de las apps. Elimina dispositivos con Xcode o `xcrun simctl`, no borrando carpetas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulaattoreissa voi olla testidataa ja appien tilaa. Poista laitteet Xcodella tai komennolla `xcrun simctl`, älä poistamalla kansioita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les simulateurs peuvent contenir des données de test et l’état d’apps. Supprimez les appareils avec Xcode ou `xcrun simctl`, pas en supprimant des dossiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिम्युलेटर में टेस्ट डेटा और ऐप की स्थिति हो सकती है। डिवाइस Xcode या `xcrun simctl` से हटाएँ, फ़ोल्डर डिलीट करके नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulator dapat menyimpan data uji dan status app. Hapus perangkat dengan Xcode atau `xcrun simctl`, bukan dengan menghapus folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I simulatori possono contenere dati di test e lo stato delle app. Rimuovi i dispositivi con Xcode o `xcrun simctl`, non eliminando le cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シミュレータにはテストデータやアプリの状態が含まれることがあります。デバイスはフォルダを削除せず、Xcode または `xcrun simctl` で削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시뮬레이터에는 테스트 데이터와 앱 상태가 있을 수 있습니다. 기기는 폴더를 삭제하지 말고 Xcode 또는 `xcrun simctl`로 제거하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulatorer kan inneholde testdata og apptilstand. Fjern enheter med Xcode eller `xcrun simctl`, ikke ved å slette mapper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulators kunnen testgegevens en appstatus bevatten. Verwijder apparaten met Xcode of `xcrun simctl`, niet door mappen te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symulatory mogą zawierać dane testowe i stan aplikacji. Usuwaj urządzenia za pomocą Xcode lub `xcrun simctl`, a nie przez usuwanie folderów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuladores podem conter dados de teste e estado de apps. Remova dispositivos com o Xcode ou `xcrun simctl`, não apagando pastas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Симуляторы могут хранить тестовые данные и состояние приложений. Удаляйте устройства через Xcode или `xcrun simctl`, а не удалением папок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulatorer kan innehålla testdata och appläge. Ta bort enheter med Xcode eller `xcrun simctl`, inte genom att radera mappar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องจำลองอาจมีข้อมูลทดสอบและสถานะแอป ลบอุปกรณ์ด้วย Xcode หรือ `xcrun simctl` ไม่ใช่ด้วยการลบโฟลเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simülatörler test verileri ve uygulama durumu içerebilir. Aygıtları klasör silerek değil, Xcode veya `xcrun simctl` ile kaldırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình mô phỏng có thể chứa dữ liệu kiểm thử và trạng thái ứng dụng. Hãy xóa thiết bị bằng Xcode hoặc `xcrun simctl`, đừng xóa thư mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟器可能保存测试数据和应用状态。请使用 Xcode 或 `xcrun simctl` 移除设备，而不是删除文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模擬器可能保存測試資料和 App 狀態。請使用 Xcode 或 `xcrun simctl` 移除裝置，而不是刪除檔案夾。"
          }
        }
      }
    },
    "Simulators rebuild their caches on next boot." : {
      "comment" : "Cleanup rule dev.coresimulator.caches (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد أجهزة المحاكاة بناء ذاكراتها المؤقتة عند الإقلاع التالي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulatorer opretter deres caches igen ved næste start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulatoren erstellen ihre Caches beim nächsten Start neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los simuladores vuelven a crear sus cachés en el siguiente arranque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulaattorit luovat välimuistinsa uudelleen seuraavalla käynnistyskerralla."
