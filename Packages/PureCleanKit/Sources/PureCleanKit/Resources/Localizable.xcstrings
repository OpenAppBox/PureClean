    "A volume's root folder cannot be moved to Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن نقل المجلد الجذر لوحدة تخزين إلى سلة المهملات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodmappen på et volumen kan ikke flyttes til papirkurven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der oberste Ordner eines Volumes kann nicht in den Papierkorb gelegt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta raíz de un volumen no se puede mover a la Papelera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
