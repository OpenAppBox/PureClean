            "state" : "translated",
            "value" : "macOS bellek baskısı düzeyini %1$lld olarak bildiriyor; %2$@ takas alanı kullanımda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS báo mức áp lực bộ nhớ %1$lld, với %2$@ bộ nhớ hoán đổi đang dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 报告内存压力等级为 %lld，正在使用 %@ 交换空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 回報記憶體壓力等級為 %lld，正在使用 %@ 的置換空間。"
          }
        }
      }
    },
