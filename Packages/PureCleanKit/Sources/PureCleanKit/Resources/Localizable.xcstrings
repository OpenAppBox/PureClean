    "Each tool downloads or rebuilds what it needs the next time it runs; the first build can be slower." : {
      "comment" : "Cleanup rule dev.tool.caches (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد كل أداة تنزيل ما تحتاج إليه أو بناءه في المرة القادمة التي تعمل فيها؛ وقد يكون البناء الأول أبطأ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert værktøj henter eller genopbygger det, det skal bruge, næste gang det kører; første build kan være langsommere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Tool lädt oder erstellt beim nächsten Start neu, was es braucht; der erste Build kann langsamer sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada herramienta descarga o regenera lo que necesita la próxima vez que se ejecuta; la primera compilación puede ser más lenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen työkalu lataa tai rakentaa tarvitsemansa uudelleen seuraavalla kerralla; ensimmäinen koonti voi olla hitaampi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque outil retélécharge ou recompile ce dont il a besoin à sa prochaine exécution ; la première compilation peut être plus lente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर टूल अगली बार चलने पर ज़रूरी चीज़ें डाउनलोड करता है या फिर से बनाता है; पहला बिल्ड धीमा हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap alat mengunduh atau membuat ulang apa yang diperlukannya saat dijalankan berikutnya; build pertama bisa lebih lambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni strumento riscarica o ricompila ciò che serve alla prossima esecuzione; la prima build può essere più lenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ツールは次回の実行時に必要なものを再ダウンロードまたは再ビルドします。最初のビルドは遅くなることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 도구는 다음 실행 시 필요한 항목을 다시 다운로드하거나 다시 빌드합니다. 첫 빌드는 느려질 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert verktøy laster ned eller bygger det som trengs neste gang det kjøres; første bygg kan være tregere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke tool downloadt of bouwt wat nodig is opnieuw bij de volgende keer; de eerste build kan trager zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde narzędzie pobierze lub zbuduje to, czego potrzebuje, przy następnym uruchomieniu; pierwsza kompilacja może być wolniejsza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ferramenta baixa ou recompila o que precisa na próxima execução; a primeira compilação pode ser mais lenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый инструмент заново загрузит или соберёт нужное при следующем запуске; первая сборка может быть медленнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje verktyg hämtar eller bygger om det som behövs nästa gång det körs; första bygget kan gå långsammare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละเครื่องมือจะดาวน์โหลดหรือสร้างสิ่งที่ต้องใช้ใหม่ในครั้งถัดไปที่ทำงาน การบิลด์ครั้งแรกอาจช้าลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her araç, bir sonraki çalışmasında gerekenleri yeniden indirir ya da derler; ilk derleme daha yavaş olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi công cụ tải về hoặc tạo lại những gì nó cần ở lần chạy tiếp theo; lần build đầu có thể chậm hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个工具会在下次运行时重新下载或重建所需内容；首次构建可能较慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個工具會在下次執行時重新下載或重建所需內容；第一次建置可能較慢。"
          }
        }
      }
    },
