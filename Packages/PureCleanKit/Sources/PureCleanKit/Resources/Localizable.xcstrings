    "Managed by Xcode. Use Xcode’s Devices window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يديره Xcode. استخدم نافذة الأجهزة في Xcode."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administreres af Xcode. Brug vinduet Enheder i Xcode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Xcode verwaltet. Nutze das Fenster „Geräte“ in Xcode."
          }
        },
        "es" : {
