    "Permission denied. PureClean does not request administrator rights; you can move it in Finder instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض الإذن. لا يطلب PureClean صلاحيات المسؤول؛ ويمكنك نقله في Finder بدلًا من ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilladelse nægtet. PureClean beder ikke om administratorrettigheder; du kan i stedet flytte den i Finder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert. PureClean fordert keine Administratorrechte an; du kannst es stattdessen im Finder verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiso denegado. PureClean no pide permisos de administrador; puedes moverlo tú en Finder."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupa evätty. PureClean ei pyydä ylläpitäjän oikeuksia; voit siirtää sen Finderissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation refusée. PureClean ne demande pas de droits d’administrateur ; vous pouvez le déplacer dans le Finder à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति अस्वीकृत। PureClean एडमिनिस्ट्रेटर अधिकार नहीं माँगता; आप इसे Finder में ख़ुद ले जा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin ditolak. PureClean tidak meminta hak administrator; Anda dapat memindahkannya di Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permesso negato. PureClean non richiede privilegi di amministratore; puoi spostarlo dal Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス権がありません。PureClean は管理者権限を要求しません。代わりに Finder で移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한이 거부되었습니다. PureClean은 관리자 권한을 요청하지 않습니다. 대신 Finder에서 이동할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tillatelse. PureClean ber ikke om administratorrettigheter; du kan flytte den i Finder i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang geweigerd. PureClean vraagt geen beheerdersrechten; je kunt het in de Finder verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmowa dostępu. PureClean nie prosi o uprawnienia administratora; zamiast tego możesz przenieść to w Finderze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
