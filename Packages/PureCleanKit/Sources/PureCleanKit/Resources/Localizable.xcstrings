            "value" : "Projekte verknüpfen fest in diesen Speicher; nutze `pnpm store prune`, statt ihn zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos crean enlaces duros a este almacén; usa `pnpm store prune` en lugar de eliminarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektit kovalinkittävät tähän varastoon; käytä komentoa `pnpm store prune` sen poistamisen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets créent des liens physiques vers ce magasin ; utilisez `pnpm store prune` au lieu de le supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोजेक्ट इस स्टोर में हार्ड-लिंक करते हैं; इसे हटाने के बजाय `pnpm store prune` इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
