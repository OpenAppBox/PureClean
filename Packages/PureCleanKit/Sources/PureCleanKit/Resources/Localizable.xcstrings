          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa Limpieza inteligente y el Explorador de almacenamiento y luego vacía la Papelera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista Älysiivous ja Tallennustilan selain ja tyhjennä sitten roskakori."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le Nettoyage intelligent et l’Explorateur de stockage, puis videz la Corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्मार्ट क्लीन और स्टोरेज एक्सप्लोरर की समीक्षा करें, फिर ट्रैश ख़ाली करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau Pembersihan Cerdas dan Penjelajah Penyimpanan, lalu kosongkan Sampah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla Pulizia intelligente ed Esplora spazio, poi svuota il Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートクリーンとストレージエクスプローラを確認してから、ゴミ箱を空にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 정리와 저장 공간 탐색기를 검토한 다음 휴지통을 비우십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå gjennom Smart rydding og Lagringsutforsker, og tøm deretter papirkurven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer Slim opschonen en Opslagverkenner en maak daarna de prullenmand leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź Inteligentne czyszczenie i Eksplorator pamięci, a potem opróżnij kosz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise a Limpeza Inteligente e o Explorador de Armazenamento e depois esvazie o Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте Умную очистку и Обозреватель хранилища, затем очистите Корзину."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska Smart rensning och Lagringsutforskaren och töm sedan papperskorgen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจทานล้างอัจฉริยะและตัวสำรวจพื้นที่จัดเก็บ แล้วล้างถังขยะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı Temizlik’i ve Depolama Gezgini’ni gözden geçirin, ardından Çöp Sepetini boşaltın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại Dọn dẹp thông minh và Trình khám phá dung lượng, rồi dọn sạch Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查智能清理和存储浏览器，然后清倒废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查智慧清理和儲存空間瀏覽器，然後清空垃圾桶。"
          }
        }
      }
    },
