        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjelmapaketin sisällä olevia tiedostoja ei koskaan poisteta yksitellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers à l’intérieur d’un paquet d’application ne sont jamais supprimés individuellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्लिकेशन बंडल के अंदर की फ़ाइलें कभी अलग से नहीं हटाई जातीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File di dalam bundel aplikasi tidak pernah dihapus satu per satu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file all’interno di un pacchetto di applicazione non vengono mai rimossi singolarmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションバンドル内のファイルが個別に削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램 번들 안의 파일은 개별적으로 제거되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer inne i en programpakke fjernes aldri enkeltvis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden binnen een programmabundel worden nooit afzonderlijk verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki wewnątrz pakietu aplikacji nigdy nie są usuwane pojedynczo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
