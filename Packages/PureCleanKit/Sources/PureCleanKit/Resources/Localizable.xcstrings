    "Files inside an application bundle are never removed individually." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُزال الملفات الموجودة داخل حزمة تطبيق بشكل منفرد أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer inde i et programbundt fjernes aldrig enkeltvis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien in einem Programm-Bundle werden nie einzeln entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de dentro de un paquete de aplicación nunca se eliminan por separado."
