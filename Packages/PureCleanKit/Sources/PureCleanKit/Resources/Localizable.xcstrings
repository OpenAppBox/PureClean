          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS मेमोरी दबाव स्तर %1$lld बताता है, जिसमें %2$@ स्वैप इस्तेमाल में है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
