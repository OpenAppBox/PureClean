        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปจะสร้างแคชใหม่ อาจเริ่มทำงานช้าลงหนึ่งครั้งและดาวน์โหลดเนื้อหาบางส่วนใหม่"
