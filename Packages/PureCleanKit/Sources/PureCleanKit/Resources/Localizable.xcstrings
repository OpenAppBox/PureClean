    "Exact bundle-identifier folder of an installed app in ~/Library/Logs, unchanged for 30 days." : {
      "comment" : "Cleanup rule logs.app.old (evidence), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد يحمل تمامًا معرّف حزمة تطبيق مثبّت في ~/Library/Logs، ولم يتغير منذ 30 يومًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
