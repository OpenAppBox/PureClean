    "Requires administrator rights — PureClean does not remove system-wide items. Shown for your information." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب صلاحيات المسؤول — لا يزيل PureClean العناصر التي على مستوى النظام. معروض للعلم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræver administratorrettigheder – PureClean fjerner ikke systemdækkende emner. Vises til orientering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert Administratorrechte – PureClean entfernt keine systemweiten Objekte. Zur Information angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere permisos de administrador — PureClean no elimina ítems de todo el sistema. Se muestra a título informativo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaatii ylläpitäjän oikeudet – PureClean ei poista järjestelmänlaajuisia kohteita. Näytetään tiedoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite des droits d’administrateur — PureClean ne supprime pas les éléments de tout le système. Affiché à titre d’information."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एडमिनिस्ट्रेटर अधिकार चाहिए — PureClean पूरे सिस्टम के आइटम नहीं हटाता। जानकारी के लिए दिखाया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memerlukan hak administrator — PureClean tidak menghapus item seluruh sistem. Ditampilkan sebagai informasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede i privilegi di amministratore — PureClean non rimuove gli elementi di sistema. Mostrato a titolo informativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者権限が必要です — PureClean はシステム全体の項目を削除しません。情報として表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자 권한 필요 — PureClean은 시스템 전체 항목을 제거하지 않습니다. 참고용으로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krever administratorrettigheter – PureClean fjerner ikke systemomfattende objekter. Vises til informasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist beheerdersrechten – PureClean verwijdert geen systeembrede onderdelen. Ter informatie getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymaga uprawnień administratora — PureClean nie usuwa elementów systemowych. Pokazane informacyjnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exige privilégios de administrador — o PureClean não remove itens de todo o sistema. Mostrado para sua informação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужны права администратора — PureClean не удаляет общесистемные объекты. Показано для сведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver administratörsbehörighet – PureClean tar inte bort systemomfattande objekt. Visas som information."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้สิทธิ์ผู้ดูแลระบบ — PureClean ไม่ลบรายการระดับระบบ แสดงไว้เพื่อให้ทราบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici hakları gerektirir — PureClean sistem genelindeki öğeleri kaldırmaz. Bilgi amacıyla gösterilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền quản trị viên — PureClean không xóa các mục toàn hệ thống. Hiển thị để bạn tham khảo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要管理员权限 — PureClean 不会移除系统范围的项目。仅供参考显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要管理者權限 — PureClean 不會移除系統層級的項目。僅供參考顯示。"
          }
        }
      }
    },
