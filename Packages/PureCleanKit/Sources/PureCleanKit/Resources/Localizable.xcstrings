  "strings" : {
    "%@ is managed by macOS and is protected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدير macOS ‏%@ وهو محمي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ administreres af macOS og er beskyttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von macOS verwaltet und ist geschützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está gestionado por macOS y está protegido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on macOS:n hallitsema ja suojattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est géré par macOS et protégé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS द्वारा प्रबंधित है और संरक्षित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dikelola oleh macOS dan dilindungi."
          }
        },
        "it" : {
