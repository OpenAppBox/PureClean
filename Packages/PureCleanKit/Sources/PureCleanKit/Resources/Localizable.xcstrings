    "Mostly tidiness: launchd retries them and logs errors, with little performance impact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسألة ترتيب في الغالب: يعيد launchd محاولة تشغيلها ويسجل الأخطاء، مع تأثير ضئيل على الأداء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mest orden: launchd prøver igen og logger fejl, med ringe betydning for ydeevnen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor allem Ordnung: launchd versucht sie erneut und protokolliert Fehler, mit wenig Einfluss auf die Leistung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre todo orden: launchd los reintenta y registra errores, con poco impacto en el rendimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähinnä siisteyttä: launchd yrittää niitä uudelleen ja kirjaa virheitä, mutta vaikutus suorituskykyyn on vähäinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
