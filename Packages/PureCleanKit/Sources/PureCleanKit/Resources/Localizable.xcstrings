    "VS Code recompiles cached code on next launch; startup is slower once." : {
      "comment" : "Cleanup rule electron.vscode.cache (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد VS Code ترجمة الشفرة المخزّنة مؤقتًا عند التشغيل التالي؛ ويكون بدء التشغيل أبطأ مرة واحدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code kompilerer cachelagret kode igen ved næste start; starten er langsommere én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code kompiliert zwischengespeicherten Code beim nächsten Start neu; der Start ist einmal langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code vuelve a compilar el código en caché en el siguiente inicio; arranca más lento una vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code kääntää välimuistissa olevan koodin uudelleen seuraavalla käynnistyskerralla; käynnistys on kerran hitaampi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code recompile le code en cache au prochain lancement ; le démarrage est plus lent une fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले लॉन्च पर VS Code कैश किया कोड फिर से कंपाइल करता है; एक बार स्टार्टअप धीमा होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code mengompilasi ulang kode yang di-cache pada peluncuran berikutnya; startup lebih lambat sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code ricompila il codice in cache al prossimo avvio; l’avvio è più lento una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code は次回の起動時にキャッシュされたコードを再コンパイルします。一度だけ起動が遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code는 다음 실행 시 캐시된 코드를 다시 컴파일합니다. 한 번은 시작이 느려집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code kompilerer bufret kode på nytt ved neste oppstart; oppstarten går tregere én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code compileert gecachete code opnieuw bij de volgende start; de start is één keer trager."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code skompiluje zbuforowany kod przy następnym uruchomieniu; uruchomienie będzie raz wolniejsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VS Code recompila o código em cache na próxima abertura; a inicialização fica mais lenta uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code перекомпилирует кэшированный код при следующем запуске; один запуск будет медленнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code kompilerar om cachad kod vid nästa start; starten blir långsammare en gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code จะคอมไพล์โค้ดที่แคชไว้ใหม่ในการเปิดครั้งถัดไป การเริ่มทำงานจะช้าลงหนึ่งครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code önbelleğe alınmış kodu bir sonraki açılışta yeniden derler; açılış bir kez daha yavaş olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code biên dịch lại mã đã lưu đệm ở lần mở tiếp theo; khởi động chậm hơn một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code 会在下次启动时重新编译缓存的代码；启动会慢一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VS Code 會在下次啟動時重新編譯快取的程式碼；啟動會慢一次。"
          }
        }
      }
    },
