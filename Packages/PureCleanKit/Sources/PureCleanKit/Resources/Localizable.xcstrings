          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app recria o cache; ele pode abrir mais devagar uma vez e baixar alguns conteúdos de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
