    "If the app is reinstalled later, its previous settings and data will be gone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أُعيد تثبيت التطبيق لاحقًا، فستكون إعداداته وبياناته السابقة قد زالت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen geninstalleres senere, er dens tidligere indstillinger og data væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird die App später neu installiert, sind ihre bisherigen Einstellungen und Daten weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la app se reinstala más adelante, sus ajustes y datos anteriores ya no estarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos appi asennetaan myöhemmin uudelleen, sen aiemmat asetukset ja tiedot ovat poissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app est réinstallée plus tard, ses réglages et données précédents auront disparu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर ऐप बाद में फिर से इंस्टॉल किया जाए, तो उसकी पिछली सेटिंग्ज़ और डेटा नहीं रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika app diinstal ulang nanti, pengaturan dan data sebelumnya akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reinstalli l’app in seguito, le sue impostazioni e i suoi dati precedenti saranno spariti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとでアプリを再インストールしても、以前の設定とデータは失われています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 앱을 다시 설치해도 이전 설정과 데이터는 사라진 상태입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen installeres på nytt senere, er de tidligere innstillingene og dataene borte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de app later opnieuw wordt geïnstalleerd, zijn de vorige instellingen en gegevens weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli później zainstalujesz aplikację ponownie, jej dawnych ustawień i danych już nie będzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o app for reinstalado depois, os ajustes e dados anteriores dele terão sumido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если позже переустановить приложение, его прежних настроек и данных не будет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
