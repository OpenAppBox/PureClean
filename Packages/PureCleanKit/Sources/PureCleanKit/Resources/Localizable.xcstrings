    "Deleting this destroys every image, container and volume. Use Docker’s own tools." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف هذا يدمّر كل الصور والحاويات ووحدات التخزين. استخدم أدوات Docker الخاصة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At slette dette ødelægger alle images, beholdere og volumener. Brug Dockers egne værktøjer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen zerstört jedes Image, jeden Container und jedes Volume. Nutze die Werkzeuge von Docker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar esto destruye todas las imágenes, contenedores y volúmenes. Usa las herramientas propias de Docker."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän poistaminen tuhoaa jokaisen imagen, säiliön ja taltion. Käytä Dockerin omia työkaluja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le supprimer détruit chaque image, conteneur et volume. Utilisez les outils de Docker."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हटाने से हर इमेज, कंटेनर और वॉल्यूम नष्ट हो जाता है। Docker के अपने टूल्स इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus ini memusnahkan setiap image, kontainer, dan volume. Gunakan alat Docker sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminarlo distrugge ogni immagine, container e volume. Usa gli strumenti di Docker."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを削除すると、すべてのイメージ、コンテナ、ボリュームが失われます。Docker 自身のツールを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목을 삭제하면 모든 이미지, 컨테이너, 볼륨이 사라집니다. Docker 자체 도구를 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å slette dette ødelegger alle bilder, beholdere og volumer. Bruk Dockers egne verktøy."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijderen vernietigt elke image, container en elk volume. Gebruik de eigen tools van Docker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie tego zniszczy każdy obraz, kontener i wolumin. Używaj własnych narzędzi Dockera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar isto destrói cada imagem, contêiner e volume. Use as ferramentas do próprio Docker."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление уничтожит все образы, контейнеры и тома. Используйте собственные инструменты Docker."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att radera det här förstör alla avbilder, containrar och volymer. Använd Dockers egna verktyg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลบส่วนนี้จะทำลายอิมเมจ คอนเทนเนอร์ และโวลุ่มทั้งหมด ใช้เครื่องมือของ Docker เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu silmek tüm imajları, kapsayıcıları ve birimleri yok eder. Docker’ın kendi araçlarını kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mục này sẽ hủy mọi image, vùng chứa và volume. Hãy dùng công cụ riêng của Docker."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此项会销毁所有映像、容器和卷。请使用 Docker 自己的工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除此項會銷毀所有映像檔、容器和卷。請使用 Docker 本身的工具。"
          }
        }
      }
    },
