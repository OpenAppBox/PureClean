    "Update packages an installed app downloaded with its updater (Squirrel “ShipIt”). They are only needed until the update is installed." : {
      "comment" : "Cleanup rule app-updates.shipit (description), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حزم تحديث نزّلها تطبيق مثبّت باستخدام أداة التحديث الخاصة به (Squirrel «ShipIt»). لا تلزم إلا حتى يُثبَّت التحديث."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdateringspakker, som en installeret app har hentet med sin opdaterer (Squirrel “ShipIt”). De er kun nødvendige, indtil opdateringen er installeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update-Pakete, die eine installierte App mit ihrem Updater (Squirrel „ShipIt“) geladen hat. Sie werden nur bis zur Installation des Updates benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquetes de actualización que una app instalada descargó con su actualizador (Squirrel “ShipIt”). Solo hacen falta hasta que se instala la actualización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivityspaketit, jotka asennettu appi latasi päivittäjällään (Squirrel ”ShipIt”). Niitä tarvitaan vain, kunnes päivitys on asennettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquets de mise à jour qu’une app installée a téléchargés avec son outil de mise à jour (Squirrel « ShipIt »). Ils ne servent que jusqu’à l’installation de la mise à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट पैकेज जो किसी इंस्टॉल किए ऐप ने अपने अपडेटर (Squirrel “ShipIt”) से डाउनलोड किए। इनकी ज़रूरत सिर्फ़ अपडेट इंस्टॉल होने तक होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket pembaruan yang diunduh app terinstal dengan pembarunya (Squirrel “ShipIt”). Paket ini hanya diperlukan sampai pembaruan terinstal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacchetti di aggiornamento che un’app installata ha scaricato con il suo aggiornatore (Squirrel “ShipIt”). Servono solo finché l’aggiornamento non è installato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みアプリがアップデータ（Squirrel「ShipIt」）でダウンロードしたアップデートパッケージ。アップデートをインストールするまでのみ必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 앱이 업데이트 프로그램(Squirrel “ShipIt”)으로 다운로드한 업데이트 패키지입니다. 업데이트가 설치될 때까지만 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateringspakker en installert app lastet ned med oppdateringsprogrammet sitt (Squirrel «ShipIt»). De trengs bare til oppdateringen er installert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updatepakketten die een geïnstalleerde app met zijn updater (Squirrel ‘ShipIt’) heeft gedownload. Ze zijn alleen nodig tot de update is geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiety aktualizacji pobrane przez zainstalowaną aplikację jej narzędziem aktualizacji (Squirrel „ShipIt”). Są potrzebne tylko do zainstalowania aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacotes de atualização que um app instalado baixou com seu atualizador (Squirrel “ShipIt”). Só são necessários até a atualização ser instalada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеты обновлений, загруженные установленным приложением через средство обновления (Squirrel «ShipIt»). Нужны только до установки обновления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdateringspaket som en installerad app hämtat med sin uppdaterare (Squirrel ”ShipIt”). De behövs bara tills uppdateringen är installerad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แพ็กเกจอัปเดตที่แอปที่ติดตั้งดาวน์โหลดด้วยตัวอัปเดตของแอป (Squirrel “ShipIt”) ต้องใช้จนกว่าจะติดตั้งการอัปเดตเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü bir uygulamanın güncelleyicisiyle (Squirrel “ShipIt”) indirdiği güncelleme paketleri. Yalnızca güncelleme yüklenene kadar gereklidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các gói cập nhật mà một ứng dụng đã cài tải về bằng trình cập nhật của nó (Squirrel “ShipIt”). Chúng chỉ cần đến khi bản cập nhật được cài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装应用通过其更新程序（Squirrel“ShipIt”）下载的更新包。仅在安装更新之前需要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝 App 透過其更新程式（Squirrel「ShipIt」）下載的更新套件。僅在安裝更新之前需要。"
          }
        }
      }
    },
    "Use Applications → Uninstall to remove apps safely." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم التطبيقات ← إلغاء التثبيت لإزالة التطبيقات بأمان."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Programmer → Afinstaller for at fjerne apps sikkert."
          }
        },
        "de" : {
