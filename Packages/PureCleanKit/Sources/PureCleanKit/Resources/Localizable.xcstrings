    "It changed since you reviewed it (it was replaced or swapped). Review again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر منذ مراجعتك له (استُبدل أو بُدّل). راجِعه مجددًا."
          }
        },
        "da" : {
