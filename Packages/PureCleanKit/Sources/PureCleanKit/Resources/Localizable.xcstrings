    "The next build of each project is a full rebuild and re-index, which can take a long time." : {
      "comment" : "Cleanup rule dev.xcode.deriveddata (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيكون البناء التالي لكل مشروع إعادة بناء وفهرسة كاملة، وقد يستغرق وقتًا طويلًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Næste build af hvert projekt bliver et fuldt genbyg og en genindeksering, hvilket kan tage lang tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
