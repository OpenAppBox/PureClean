    "The app recreates its cache; it may start more slowly once and re-download some content." : {
      "comment" : "Cleanup rule app-caches.installed (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد التطبيق إنشاء ذاكرته المؤقتة؛ وقد يبدأ أبطأ مرة واحدة ويعيد تنزيل بعض المحتوى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen opretter sin cache igen; den starter måske langsommere én gang og henter noget indhold igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App legt ihren Cache neu an; sie startet eventuell einmal langsamer und lädt manche Inhalte neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app vuelve a crear su caché; puede que tarde más en abrirse una vez y vuelva a descargar algo de contenido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appi luo välimuistinsa uudelleen; se voi käynnistyä kerran hitaammin ja ladata sisältöä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app recrée son cache ; elle peut démarrer une fois plus lentement et retélécharger du contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप अपना कैश फिर से बनाता है; एक बार धीरे शुरू हो सकता है और कुछ सामग्री फिर से डाउनलोड कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App membuat ulang cache-nya; mungkin akan dimulai lebih lambat sekali dan mengunduh ulang sebagian konten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ricrea la sua cache; potrebbe avviarsi più lentamente una volta e riscaricare alcuni contenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリはキャッシュを再作成します。一度だけ起動が遅くなったり、一部のコンテンツを再ダウンロードしたりすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 캐시를 다시 만듭니다. 한 번은 더 느리게 시작되고 일부 콘텐츠를 다시 다운로드할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen lager bufferen på nytt; den kan starte tregere én gang og laste ned noe innhold på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app maakt de cache opnieuw aan; hij start mogelijk één keer trager en downloadt sommige inhoud opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
