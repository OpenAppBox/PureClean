          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 메모리 압력 수준 %lld을(를) 보고하며, 스왑 %@을(를) 사용 중입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS rapporterer minnepressnivå %lld, med %@ vekselminne i bruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meldt geheugendrukniveau %lld, met %@ wisselgeheugen in gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zgłasza poziom obciążenia pamięci %lld, w użyciu pamięć wymiany: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS informa o nível de pressão da memória %lld, com %@ de swap em uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS сообщает уровень нагрузки на память %lld, используется подкачки: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS rapporterar minnestrycksnivå %lld, med %@ växlingsutrymme i bruk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS รายงานระดับแรงกดดันหน่วยความจำ %1$lld โดยใช้สวอปอยู่ %2$@"
          }
        },
        "tr" : {
