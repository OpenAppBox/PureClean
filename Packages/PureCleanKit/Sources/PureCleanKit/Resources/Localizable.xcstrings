          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode จะคัดลอกสัญลักษณ์ใหม่เมื่อคุณเชื่อมต่ออุปกรณ์นั้นครั้งถัดไป ซึ่งอาจใช้เวลาหลายนาที"
