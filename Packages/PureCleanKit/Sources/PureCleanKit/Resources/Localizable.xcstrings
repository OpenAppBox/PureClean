    "The app re-downloads images and recompiles scripts; the first launch is slower." : {
      "comment" : "Cleanup rule electron.app.cache (regenerationImpact), CleanupRules.json",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
