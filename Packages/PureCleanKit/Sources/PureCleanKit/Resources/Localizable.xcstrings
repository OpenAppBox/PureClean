    "Review them below. Your own (~/Library) items appear under Orphaned Remnants; system-wide ones need an administrator." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجِعها أدناه. تظهر عناصرك الخاصة (~/Library) ضمن البقايا اليتيمة؛ أما العناصر التي على مستوى النظام فتحتاج إلى مسؤول."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå dem nedenfor. Dine egne (~/Library) vises under Forældreløse rester; systemdækkende kræver en administrator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe sie unten. Deine eigenen (~/Library) erscheinen unter „Verwaiste Reste“; systemweite brauchen einen Administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revísalos abajo. Tus propios ítems (~/Library) aparecen en Restos huérfanos; los de todo el sistema necesitan un administrador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista ne alta. Omasi (~/Library) näkyvät kohdassa Orvot jäänteet; järjestelmänlaajuiset vaativat ylläpitäjän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez-les ci-dessous. Les vôtres (~/Library) apparaissent dans Restes orphelins ; ceux de tout le système nécessitent un administrateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें नीचे देखें। आपके अपने (~/Library) आइटम छूटे हुए अवशेष में दिखते हैं; पूरे सिस्टम वालों के लिए एडमिनिस्ट्रेटर चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau di bawah. Item Anda sendiri (~/Library) muncul di Sisa Tertinggal; item seluruh sistem memerlukan administrator."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllali qui sotto. I tuoi (~/Library) appaiono in Residui orfani; quelli di sistema richiedono un amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下で確認してください。ご自身の項目（~/Library）は「孤立した残りファイル」に表示されます。システム全体の項目には管理者が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에서 검토하십시오. 사용자 본인의 항목(~/Library)은 삭제된 앱 잔여 파일에 표시되며, 시스템 전체 항목에는 관리자가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå gjennom dem nedenfor. Dine egne (~/Library) vises under Foreldreløse rester; systemomfattende krever en administrator."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer ze hieronder. Die van jezelf (~/Library) staan bij Verweesde restanten; systeembrede vereisen een beheerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź je poniżej. Twoje własne (~/Library) są w Osieroconych pozostałościach; systemowe wymagają administratora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise-os abaixo. Os seus (~/Library) aparecem em Restos Órfãos; os de todo o sistema exigem um administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте их ниже. Ваши собственные (~/Library) показаны в разделе «Осиротевшие остатки»; для общесистемных нужен администратор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska dem nedan. Dina egna (~/Library) visas under Kvarlämnade rester; systemomfattande kräver en administratör."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจทานด้านล่าง รายการของคุณเอง (~/Library) อยู่ในไฟล์ตกค้าง รายการระดับระบบต้องใช้ผู้ดูแลระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları aşağıda inceleyin. Sizin (~/Library) öğeleriniz Sahipsiz Kalıntılar altında görünür; sistem genelindekiler için yönetici gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại chúng bên dưới. Các mục của riêng bạn (~/Library) xuất hiện trong Tệp sót lại; các mục toàn hệ thống cần quản trị viên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在下方检查。你自己的（~/Library）项目显示在“孤立残留”下；系统范围的项目需要管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在下方檢查。你自己的（~/Library）項目會顯示在「孤立殘留檔案」下；系統層級的項目需要管理者。"
          }
        }
      }
    },
